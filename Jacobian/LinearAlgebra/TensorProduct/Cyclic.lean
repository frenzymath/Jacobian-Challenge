import Mathlib.LinearAlgebra.TensorProduct.Basic

/-!
# Tensor products with a cyclic module

If `P` is generated by a single element `p₀` and `B : P →ₗ Q →ₗ N` is bilinear with `B p₀`
bijective, then `TensorProduct.lift B : P ⊗ Q → N` is bijective
(`TensorProduct.lift_bijective_of_forall_eq_smul`).
-/


/-- Let `B : P →ₗ Q →ₗ N` be bilinear. If `P` is generated by a single element `p₀` and
`B p₀ : Q → N` is bijective, then the induced map `P ⊗ Q → N` is bijective. -/
lemma TensorProduct.lift_bijective_of_forall_eq_smul {A P Q N : Type*} [CommRing A]
    [AddCommGroup P] [Module A P] [AddCommGroup Q] [Module A Q] [AddCommGroup N] [Module A N]
    (B : P →ₗ[A] Q →ₗ[A] N) (p₀ : P) (hp₀ : ∀ p : P, ∃ a : A, p = a • p₀)
    (hB : Function.Bijective (B p₀)) : Function.Bijective (TensorProduct.lift B) := by
  have key (t : TensorProduct A P Q) : ∃ q : Q, t = p₀ ⊗ₜ q := by
    induction t using TensorProduct.induction_on with
    | zero => exact ⟨0, by simp⟩
    | tmul p q =>
      obtain ⟨a, rfl⟩ := hp₀ p
      exact ⟨a • q, TensorProduct.smul_tmul _ _ _⟩
    | add t t' ht ht' =>
      obtain ⟨q, rfl⟩ := ht
      obtain ⟨q', rfl⟩ := ht'
      exact ⟨q + q', (TensorProduct.tmul_add _ _ _).symm⟩
  refine ⟨fun t t' h ↦ ?_, fun n ↦ ?_⟩
  · obtain ⟨q, rfl⟩ := key t
    obtain ⟨q', rfl⟩ := key t'
    rw [TensorProduct.lift.tmul, TensorProduct.lift.tmul] at h
    rw [hB.1 h]
  · obtain ⟨q, rfl⟩ := hB.2 n
    exact ⟨p₀ ⊗ₜ q, TensorProduct.lift.tmul _ _⟩
