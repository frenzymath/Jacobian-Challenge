import Jacobian.AlgebraicGeometry.IdealSheaf.EffectiveCartier
import Jacobian.AlgebraicGeometry.Curve.Dimension
import Jacobian.RingTheory.RingHom.RegularQuotient
import Mathlib.AlgebraicGeometry.ZariskisMainTheorem

/-!
# Effective Cartier divisors on smooth curves

The affine section rings of a smooth curve have dimension at most one. A regular principal
quotient is therefore quasi-finite over the ground field. Properness makes every effective
Cartier divisor finite. Closed points are effective Cartier divisors over arbitrary fields.
-/

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
universe u
open CategoryTheory Limits AlgebraicGeometry
open scoped nonZeroDivisors

namespace AlgebraicGeometry

/-- The section ring of an affine open of a smooth curve has dimension at most one. -/
theorem IsAffineOpen.ringKrullDim_le_one_of_smooth_curve {K : Type u} [Field K]
    {X : Scheme.{u}} (p : X ⟶ Spec (.of K)) [SmoothOfRelativeDimension 1 p]
    {U : X.Opens} (hU : IsAffineOpen U) : ringKrullDim Γ(X, U) ≤ 1 := by
  rw [← PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim]
  exact hU.fromSpec.isOpenEmbedding.isInducing.topologicalKrullDim_le.trans
    (by exact_mod_cast topologicalKrullDim_le_of_smoothOfRelativeDimension p 1)

end AlgebraicGeometry

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X : Scheme.{u}} {K : Type u} [Field K]

/-- A regular Cartier ideal cuts a quasi-finite closed subscheme out of an
smooth curve over an arbitrary field. -/
theorem IsInvertible.locallyQuasiFinite_subschemeι_comp
    (p : X ⟶ Spec (.of K)) [SmoothOfRelativeDimension 1 p]
    {J : X.IdealSheafData} (hJ : J.IsInvertible) :
    LocallyQuasiFinite (J.subschemeι ≫ p) := by
  have := SmoothOfRelativeDimension.smooth 1 p
  rw [HasRingHomProperty.iff_exists_appLE (P := @LocallyQuasiFinite)
    (RingHom.QuasiFinite.stableUnderComposition.stableUnderCompositionWithLocalizationAway
      RingHom.QuasiFinite.holdsForLocalizationAway).left]
  intro d
  obtain ⟨U, hU, f, hf, hJU⟩ := hJ (J.subschemeι d)
  letI : Nonempty U.1 := ⟨⟨J.subschemeι d, hU⟩⟩
  refine ⟨⟨⊤, isAffineOpen_top _⟩, ⟨_, U.2.preimage J.subschemeι⟩, hU, le_top, ?_⟩
  rw [← Scheme.Hom.appLE_comp_appLE _ _ _ U.1 _ le_top le_rfl, CommRingCat.hom_comp,
    ← Scheme.Hom.app_eq_appLE]
  refine RingHom.quasiFinite_comp_of_regular_quotient ?_ _ ?_ ?_ _
    (J.subschemeι.app_surjective U.1 U.2) hf ?_
  · exact MulEquiv.isField (Field.toIsField K)
      (Scheme.ΓSpecIso (.of K)).commRingCatIsoToRingEquiv.toMulEquiv
  · exact HasRingHomProperty.appLE (P := @LocallyOfFiniteType) p inferInstance
      ⟨⊤, isAffineOpen_top _⟩ U le_top
  · exact IsAffineOpen.ringKrullDim_le_one_of_smooth_curve p U.2
  · rw [← RingHom.mem_ker, J.ker_subschemeι_app, hJU]
    exact Ideal.subset_span rfl

/-- Properness upgrades the Cartier quasi-finite map to a finite map. -/
theorem IsInvertible.isFinite_subschemeι_comp
    (p : X ⟶ Spec (.of K)) [SmoothOfRelativeDimension 1 p]
    [IsProper p] {J : X.IdealSheafData} (hJ : J.IsInvertible) :
    IsFinite (J.subschemeι ≫ p) := by
  have := hJ.locallyQuasiFinite_subschemeι_comp p
  exact IsFinite.of_isProper_of_locallyQuasiFinite _

end AlgebraicGeometry.Scheme.IdealSheafData

namespace AlgebraicGeometry

variable {k : Type u} [Field k] {X : Scheme.{u}}

/-- A closed point whose stalk is a discrete valuation ring has a neighborhood on which
its ideal is generated by a non-zerodivisor. -/
lemma exists_affineOpen_isRegularPrincipal_vanishingIdeal [IsLocallyNoetherian X] {Q : X}
    (hQ : IsClosed ({Q} : Set X)) [IsDomain (X.presheaf.stalk Q)]
    [IsDiscreteValuationRing (X.presheaf.stalk Q)] :
    ∃ U : X.affineOpens, Q ∈ U.1 ∧
      ((Scheme.IdealSheafData.vanishingIdeal ⟨{Q}, hQ⟩).ideal U).IsRegularPrincipal := by
  obtain ⟨U, hU, hQU, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := Q) trivial
  let x : U := ⟨Q, hQU⟩
  set q := hU.primeIdealOf x
  let := TopCat.Presheaf.algebra_section_stalk X.presheaf x
  have := hU.isLocalization_stalk x
  have : IsNoetherianRing Γ(X, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  obtain ⟨g, hg, π, hπ, h1, h2⟩ :=
    Ideal.exists_away_regularPrincipal_of_isDiscreteValuationRing q.asIdeal (X.presheaf.stalk Q)
  let F := X.presheaf.map (homOfLE (X.basicOpen_le g)).op
  let : Algebra Γ(X, U) Γ(X, X.basicOpen g) := F.hom.toAlgebra
  have : IsLocalization.Away g Γ(X, X.basicOpen g) := hU.isLocalization_of_eq_basicOpen _ _ rfl
  refine ⟨X.affineBasicOpen (U := ⟨U, hU⟩) g, ?_, ?_⟩
  · have : q ∈ hU.fromSpec ⁻¹ᵁ X.basicOpen g := by
      rw [hU.fromSpec_preimage_basicOpen]; exact hg
    have e : hU.fromSpec q = Q := hU.fromSpec_primeIdealOf x
    change Q ∈ X.basicOpen g
    rw [← e]
    exact this
  · rw [← Scheme.IdealSheafData.map_ideal_basicOpen (U := ⟨U, hU⟩)]
    have hJU : (Scheme.IdealSheafData.vanishingIdeal ⟨{Q}, hQ⟩).ideal ⟨U, hU⟩ = q.asIdeal := by
      rw [Scheme.IdealSheafData.vanishingIdeal_ideal]
      have : hU.fromSpec ⁻¹' {Q} = {q} := by
        ext y
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        constructor
        · intro hy
          apply hU.fromSpec.isOpenEmbedding.injective
          rw [hy, hU.fromSpec_primeIdealOf]
        · rintro rfl; exact hU.fromSpec_primeIdealOf x
      erw [this]
      rw [PrimeSpectrum.vanishingIdeal_singleton]
    rw [hJU]
    have := Ideal.isRegularPrincipal_map_away (B := Γ(X, X.basicOpen g)) g _ π hπ h1 h2
    exact this


/-- Every closed point of a smooth curve is an effective Cartier divisor. -/
theorem isInvertible_vanishingIdeal_of_smooth_curve
    (f : X ⟶ Spec (.of k)) [SmoothOfRelativeDimension 1 f]
    {Q : X} (hQ : IsClosed ({Q} : Set X)) :
    (Scheme.IdealSheafData.vanishingIdeal ⟨{Q}, hQ⟩).IsInvertible := by
  letI : Smooth f := SmoothOfRelativeDimension.smooth 1 f
  letI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  obtain ⟨domain, discreteValuation⟩ := Scheme.isDiscreteValuationRing_stalk_of_isClosed f hQ
  letI := domain
  letI := discreteValuation
  intro x
  by_cases hx : x = Q
  · subst hx
    exact exists_affineOpen_isRegularPrincipal_vanishingIdeal hQ
  · obtain ⟨U, hU, hxU, hUQ⟩ :=
      exists_isAffineOpen_mem_and_subset (U := ⟨{Q}ᶜ, hQ.isOpen_compl⟩) (x := x) hx
    refine ⟨⟨U, hU⟩, hxU, 1, one_mem _, ?_⟩
    rw [Ideal.span_singleton_one, Scheme.IdealSheafData.vanishingIdeal_ideal]
    have : hU.fromSpec ⁻¹' {Q} = ∅ := by
      ext y
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_empty_iff_false, iff_false]
      intro hy
      have : hU.fromSpec y ∈ (U : Set X) := hU.range_fromSpec ▸ ⟨y, rfl⟩
      exact hUQ this hy
    erw [this]
    rw [PrimeSpectrum.vanishingIdeal_empty]

/-- A nonempty smooth proper curve has a nonempty effective Cartier divisor. -/
theorem exists_nonempty_effectiveCartierDivisor (f : X ⟶ Spec (.of k))
    [SmoothOfRelativeDimension 1 f] [IsProper f] [Nonempty X] :
    ∃ J : X.IdealSheafData, J.IsInvertible ∧ (J.support : Set X).Nonempty := by
  letI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  obtain ⟨point, _, closed⟩ := isClosed_univ.exists_closed_singleton
    (Set.univ_nonempty : (Set.univ : Set X).Nonempty)
  refine ⟨Scheme.IdealSheafData.vanishingIdeal ⟨{point}, closed⟩,
    isInvertible_vanishingIdeal_of_smooth_curve f closed, ?_⟩
  simpa using (Set.singleton_nonempty point)

end AlgebraicGeometry
