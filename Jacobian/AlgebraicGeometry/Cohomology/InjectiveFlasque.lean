import Jacobian.Algebra.Category.ModuleCat.Presheaf.Generator
import Jacobian.AlgebraicGeometry.Cohomology.DirectImage.Basic
import Jacobian.Topology.Sheaves.CechFlasque

/-!
# Acyclicity of injective module sheaves

Free module sheaves on opens corepresent sections. Injective module sheaves
are consequently flasque as abelian sheaves, as are their restrictions to
open subschemes. Their positive-degree native sheaf cohomology vanishes.
-/

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u

open CategoryTheory Limits Opposite

namespace AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}}

/-- The free `𝒪_X`-module `𝒪_X[U]` generated by an open `U`. -/
noncomputable abbrev freeOpen (U : X.Opens) : X.Modules :=
  (PresheafOfModules.sheafification.{u} (𝟙 X.ringCatSheaf.obj)).obj
    ((PresheafOfModules.free X.ringCatSheaf.obj).obj (yoneda.obj U))

/-- The morphism `𝒪_X[V] ⟶ 𝒪_X[U]` induced by an inclusion `V ≤ U`. -/
noncomputable abbrev freeOpenMap {U V : X.Opens} (i : V ⟶ U) : freeOpen V ⟶ freeOpen U :=
  (PresheafOfModules.sheafification.{u} (𝟙 X.ringCatSheaf.obj)).map
    ((PresheafOfModules.free X.ringCatSheaf.obj).map (yoneda.map i))

instance mono_freeOpenMap {U V : X.Opens} (i : V ⟶ U) : Mono (freeOpenMap i) := by
  have : Mono ((PresheafOfModules.free X.ringCatSheaf.obj).map (yoneda.map i)) := by
    refine PresheafOfModules.mono_of_injective fun W ↦ ?_
    have hg : Function.Injective ((yoneda.map i).app W) := fun a b _ ↦
      Subsingleton.elim (α := W.unop ⟶ V) a b
    exact Finsupp.mapDomain_injective hg
  have : PreservesFiniteLimits (PresheafOfModules.sheafification.{u} (𝟙 X.ringCatSheaf.obj)) :=
    inferInstance
  exact Functor.map_mono _ _

/-- Morphisms `𝒪_X[U] ⟶ M` are the sections of `M` over `U`. -/
noncomputable def freeOpenHomEquiv (U : X.Opens) (M : X.Modules) : (freeOpen U ⟶ M) ≃ Γ(M, U) :=
  ((PresheafOfModules.sheafificationAdjunction.{u} (𝟙 X.ringCatSheaf.obj)).homEquiv _ _).trans
    PresheafOfModules.freeYonedaEquiv

variable {M : X.Modules}

/-- Restricting the section attached to `ψ : 𝒪_X[U] ⟶ M` to `V ≤ U` gives the section attached
to the composite `𝒪_X[V] ⟶ 𝒪_X[U] ⟶ M`. -/
lemma freeOpenHomEquiv_comp {U V : X.Opens} (i : V ⟶ U) (ψ : freeOpen U ⟶ M) :
    freeOpenHomEquiv V M (freeOpenMap i ≫ ψ) = M.presheaf.map i.op (freeOpenHomEquiv U M ψ) := by
  simp only [freeOpenHomEquiv, Equiv.trans_apply, Adjunction.homEquiv_naturality_left]
  set φ := (PresheafOfModules.sheafificationAdjunction.{u} (𝟙 X.ringCatSheaf.obj)).homEquiv _ _ ψ
  change φ.app (op V) (PresheafOfModules.freeYonedaEquiv
    ((PresheafOfModules.free X.ringCatSheaf.obj).map (yoneda.map i))) = _
  refine Eq.trans ?_ ((PresheafOfModules.naturality_apply φ i.op _).trans
    (congrArg _ (PresheafOfModules.freeYonedaEquiv_apply φ).symm))
  congr 1
  rw [PresheafOfModules.freeYonedaEquiv_apply]
  refine Eq.trans ?_
    (PresheafOfModules.freeYoneda_map_freeYonedaGen (R := X.ringCatSheaf.obj) i).symm
  simp only [PresheafOfModules.freeYonedaGen]
  change Finsupp.mapDomain _ (Finsupp.single _ 1) = Finsupp.single _ 1
  rw [Finsupp.mapDomain_single]
  exact congrArg (Finsupp.single · 1) (Category.id_comp i)

/-- **Injective `𝒪_X`-modules are flasque**: every section over `V` of an injective
`𝒪_X`-module extends to any open `U ≥ V`, since `𝒪_X[V] ⟶ 𝒪_X[U]` is a monomorphism. -/
theorem isFlasque_of_injective (I : X.Modules) [Injective I] :
    TopCat.Presheaf.IsFlasque ((SheafOfModules.toSheaf X.ringCatSheaf).obj I).obj where
  epi {U V} i := by
    refine (AddCommGrpCat.epi_iff_surjective _).mpr fun s ↦ ?_
    obtain ⟨ψ, rfl⟩ := (freeOpenHomEquiv V.unop I).surjective s
    let φ := Injective.factorThru ψ (freeOpenMap i.unop)
    refine ⟨freeOpenHomEquiv U.unop I φ, ?_⟩
    have h := freeOpenHomEquiv_comp i.unop φ
    rw [Injective.comp_factorThru] at h
    exact h.symm

/-- **Injective `𝒪_X`-modules are acyclic**: an injective `𝒪_X`-module has vanishing cohomology
in every positive degree, its underlying abelian sheaf being flasque. -/
theorem subsingleton_H_of_injective (I : X.Modules) [Injective I] (n : ℕ) :
    Subsingleton (I.H (n + 1)) :=
  have := isFlasque_of_injective I
  TopCat.Sheaf.IsFlasque.subsingleton_H n ((SheafOfModules.toSheaf X.ringCatSheaf).obj I)


/-- **Restrictions of injective `𝒪_X`-modules to open subschemes are acyclic**: the restriction of
an injective `𝒪_Y`-module along an open immersion is flasque, its sections being sections of the
injective module over the image opens. -/
theorem subsingleton_H_restrict_of_injective {X Y : Scheme.{u}} (f : X ⟶ Y) [IsOpenImmersion f]
    (I : Y.Modules) [Injective I] (n : ℕ) : Subsingleton ((I.restrict f).H (n + 1)) :=
  have := isFlasque_of_injective I
  have : TopCat.Presheaf.IsFlasque
      ((SheafOfModules.toSheaf X.ringCatSheaf).obj (I.restrict f)).obj :=
    ⟨fun i ↦ inferInstanceAs
      (Epi (((SheafOfModules.toSheaf Y.ringCatSheaf).obj I).obj.map (f.opensFunctor.op.map i)))⟩
  TopCat.Sheaf.IsFlasque.subsingleton_H n
    ((SheafOfModules.toSheaf X.ringCatSheaf).obj (I.restrict f))
end AlgebraicGeometry.Scheme.Modules
