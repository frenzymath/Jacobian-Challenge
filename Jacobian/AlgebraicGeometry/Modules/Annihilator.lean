import Jacobian.AlgebraicGeometry.Modules.AffineSections
import Jacobian.AlgebraicGeometry.Modules.FinitePresentation
import Jacobian.AlgebraicGeometry.Modules.LocalIsomorphism
import Jacobian.AlgebraicGeometry.Modules.Localization
import Jacobian.AlgebraicGeometry.Modules.Vanishing
import Jacobian.LinearAlgebra.TensorProduct.Quotient
import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion

/-!
# Annihilator ideal sheaves and closed support

Annihilators of finite modules localize on affine basic opens. They therefore
form an ideal sheaf for a finitely presented quasi-coherent module. The module
is recovered from the closed subscheme defined by its annihilator, and vanishing
on an open makes this closed support disjoint from that open.
-/

noncomputable section

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u

open CategoryTheory Limits TopologicalSpace

namespace AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}} (M : X.Modules)

set_option backward.isDefEq.respectTransparency false in
/-- **The annihilator commutes with restriction to basic opens.** For `M` quasi-coherent, `U`
affine with `Γ(M, U)` finite over `Γ(X, U)` and `f ∈ Γ(X, U)`, the annihilator of `Γ(M, D(f))`
is generated by the restriction of the annihilator of `Γ(M, U)`, as `Γ(M, D(f))` is the
localization of `Γ(M, U)` at `f`. -/
lemma map_annihilator_basicOpen [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) M]
    {U : X.Opens} (hU : IsAffineOpen U) (f : Γ(X, U))
    (hfin : Module.Finite Γ(X, U) Γ(M, U)) :
    (Module.annihilator Γ(X, U) Γ(M, U)).map
        (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom =
      Module.annihilator Γ(X, X.basicOpen f) Γ(M, X.basicOpen f) := by
  let ρ := (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom
  let := ρ.toAlgebra
  have hloc : IsLocalization.Away f Γ(X, X.basicOpen f) := by
    convert hU.isLocalization_basicOpen f
  have hunit : IsUnit (ρ f) := IsLocalization.Away.algebraMap_isUnit (S := Γ(X, X.basicOpen f)) f
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, Module.mem_annihilator]
    intro s
    obtain ⟨n, t, ht⟩ := exists_map_eq_pow_smul_of_isAffineOpen M hU f s
    have h0 : ρ f ^ n • (ρ a • s) = 0 := by
      rw [smul_comm, ← ht]
      change X.presheaf.map (homOfLE (X.basicOpen_le f)).op a • _ = 0
      rw [← map_smul, Module.mem_annihilator.1 ha t, map_zero]
    exact ((hunit.pow n).smul_left_cancel).1 (h0.trans (smul_zero _).symm)
  · intro b hb
    obtain ⟨⟨a, ⟨_, k, rfl⟩⟩, hab⟩ := IsLocalization.surj (Submonoid.powers f) b
    change b * ρ (f ^ k) = ρ a at hab
    have hgen (m : Γ(M, U)) : ∃ n : ℕ, (f ^ n * a) • m = 0 := by
      have h1 : M.presheaf.map (homOfLE (X.basicOpen_le f)).op (a • m) = 0 := by
        rw [map_smul]
        change ρ a • _ = 0
        rw [← hab, mul_comm, mul_smul, Module.mem_annihilator.1 hb, smul_zero]
      obtain ⟨n, hn⟩ := exists_pow_smul_eq_zero_of_isAffineOpen M hU f _ h1
      exact ⟨n, by rw [mul_smul]; exact hn⟩
    obtain ⟨s, hs⟩ := hfin.fg_top
    choose n hn using hgen
    let N := s.sup n
    have hN : f ^ N * a ∈ Module.annihilator Γ(X, U) Γ(M, U) := by
      rw [Module.mem_annihilator]
      intro m
      have hm : m ∈ Submodule.span Γ(X, U) (s : Set Γ(M, U)) := hs ▸ Submodule.mem_top
      induction hm using Submodule.span_induction with
      | mem x hx =>
        have hle : n x ≤ N := Finset.le_sup hx
        rw [← Nat.sub_add_cancel hle, pow_add, mul_assoc, mul_smul, hn x, smul_zero]
      | zero => exact smul_zero _
      | add x y _ _ hx hy => rw [smul_add, hx, hy, add_zero]
      | smul r x _ hx => rw [smul_comm, hx, smul_zero]
    change b ∈ Ideal.map (algebraMap Γ(X, U) Γ(X, X.basicOpen f)) _
    rw [IsLocalization.mem_map_algebraMap_iff (Submonoid.powers f)]
    refine ⟨⟨⟨_, hN⟩, ⟨f ^ (k + N), k + N, rfl⟩⟩, ?_⟩
    change b * ρ (f ^ (k + N)) = ρ (f ^ N * a)
    rw [pow_add, map_mul, ← mul_assoc, hab, map_mul, mul_comm]

/-- **The annihilator ideal sheaf** of a quasi-coherent module `M` of finite presentation: the
quasi-coherent ideal sheaf whose ideal on an affine open `U` is the annihilator of the finite
`Γ(X, U)`-module `Γ(M, U)`. -/
noncomputable def annihilatorIdealSheaf [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) M]
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) M] : X.IdealSheafData where
  ideal U := Module.annihilator Γ(X, U) Γ(M, U)
  map_ideal_basicOpen U f :=
    by
      let := finitePresentation_sections_of_isFinitePresentation M U.2
      exact map_annihilator_basicOpen M U.2 f inferInstance

lemma annihilatorIdealSheaf_ideal [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) M]
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) M] (U : X.affineOpens) :
    (annihilatorIdealSheaf M).ideal U = Module.annihilator Γ(X, U) Γ(M, U) :=
  rfl

set_option backward.isDefEq.respectTransparency false in
/-- **A module killed by an ideal sheaf lives on its closed subscheme.** If the quasi-coherent
module `M` is killed by the ideal sheaf `I`, i.e. `I(U)` kills `Γ(M, U)` for every affine open
`U`, then the unit `M ⟶ ι_* ι^* M` of the closed immersion `ι : V(I) ⟶ X` is an isomorphism:
on an affine open `U`, the sections of `ι^* M` over `ι⁻¹ U` are
`Γ(X, U) / I(U) ⊗[Γ(X, U)] Γ(M, U) = Γ(M, U)`. -/
theorem isIso_pullbackUnit_subschemeι_of_smul_eq_zero
    [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) M] (I : X.IdealSheafData)
    (hI : ∀ (U : X.affineOpens), ∀ a ∈ I.ideal U, ∀ m : Γ(M, U), a • m = 0) :
    IsIso (pullbackUnit I.subschemeι M) := by
  refine isIso_of_bijective_app_of_isAffineOpen _ fun V hV ↦ ?_
  have hV' : IsAffineOpen (I.subschemeι ⁻¹ᵁ V) := hV.preimage I.subschemeι
  obtain ⟨e, he⟩ := exists_linearEquiv_pullback_sections I.subschemeι M hV hV' le_rfl
  let := (I.subschemeι.appLE V (I.subschemeι ⁻¹ᵁ V) le_rfl).hom.toAlgebra
  have happ : I.subschemeι.appLE V (I.subschemeι ⁻¹ᵁ V) le_rfl = I.subschemeι.app V := by
    rw [Scheme.Hom.app_eq_appLE]
  have hsurj : Function.Surjective
      (algebraMap Γ(X, V) Γ(I.subscheme, I.subschemeι ⁻¹ᵁ V)) := by
    change Function.Surjective (I.subschemeι.appLE V (I.subschemeι ⁻¹ᵁ V) le_rfl).hom
    rw [happ]
    exact I.subschemeι_app_surjective ⟨V, hV⟩
  have hker : RingHom.ker (algebraMap Γ(X, V) Γ(I.subscheme, I.subschemeι ⁻¹ᵁ V)) =
      I.ideal ⟨V, hV⟩ := by
    change RingHom.ker (I.subschemeι.appLE V (I.subschemeι ⁻¹ᵁ V) le_rfl).hom = _
    rw [happ]
    exact I.ker_subschemeι_app ⟨V, hV⟩
  have hb := TensorProduct.bijective_one_tmul_of_surjective (M := Γ(M, V)) hsurj
    (fun a ha m ↦ hI ⟨V, hV⟩ a (hker ▸ ha) m)
  have key := e.bijective.comp hb
  have heq' (m : Γ(M, V)) : (pullbackUnit I.subschemeι M).app V m =
      (e ∘ fun m : Γ(M, V) ↦ (1 : Γ(I.subscheme, I.subschemeι ⁻¹ᵁ V)) ⊗ₜ[Γ(X, V)] m) m := by
    change pullbackSection I.subschemeι m = e (1 ⊗ₜ m)
    rw [he]
    have : (homOfLE (le_rfl : I.subschemeι ⁻¹ᵁ V ≤ I.subschemeι ⁻¹ᵁ V)).op = 𝟙 _ :=
      Subsingleton.elim _ _
    rw [this, CategoryTheory.Functor.map_id]
    rfl
  refine ⟨fun a b h ↦ key.1 ?_, fun y ↦ ?_⟩
  · rw [← heq', ← heq']
    exact h
  · obtain ⟨x, hx⟩ := key.2 y
    exact ⟨x, (heq' x).trans hx⟩

/-- **Modules vanishing on an open come from a closed subscheme disjoint from it.** Let `M` be a
quasi-coherent module of finite presentation vanishing on the open `O`. Then there is a
quasi-coherent ideal sheaf `I`, namely the annihilator of `M`, whose support does not meet `O`,
such that `M` is the pushforward of its pullback to `V(I)`: the unit `M ⟶ ι_* ι^* M` of the
closed immersion `ι : V(I) ⟶ X` is an isomorphism. -/
theorem exists_isIso_pullbackUnit_subschemeι
    [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) M]
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) M] (O : X.Opens)
    (hO : IsZero (M.restrict O.ι)) :
    ∃ I : X.IdealSheafData, (∀ x ∈ O, x ∉ I.support) ∧ IsIso (pullbackUnit I.subschemeι M) := by
  refine ⟨annihilatorIdealSheaf M, fun x hx hsupp ↦ ?_,
    isIso_pullbackUnit_subschemeι_of_smul_eq_zero M _ fun U a ha m ↦
      Module.mem_annihilator.1 ha m⟩
  obtain ⟨U, hU, hxU, hUO⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.1 X.isBasis_affineOpens) hx
  have : Subsingleton Γ(M, U) := (isZero_restrict_iff M O).1 hO U hUO
  have htop : (annihilatorIdealSheaf M).ideal ⟨U, hU⟩ = ⊤ := by
    rw [annihilatorIdealSheaf_ideal, eq_top_iff]
    intro a _
    rw [Module.mem_annihilator]
    exact fun m ↦ Subsingleton.elim _ _
  rw [IdealSheafData.mem_support_iff_of_mem (U := ⟨U, hU⟩) hxU, htop] at hsupp
  have h1 := (Scheme.mem_zeroLocus_iff _ _ _).1 hsupp 1 Submodule.mem_top
  rw [Scheme.basicOpen_one] at h1
  exact h1 hxU

end AlgebraicGeometry.Scheme.Modules
