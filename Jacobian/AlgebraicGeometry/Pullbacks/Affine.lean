import Jacobian.CategoryTheory.Limits.Shapes.Pullback.Products
import Jacobian.RingTheory.TensorProduct.Generators
import Mathlib.AlgebraicGeometry.Limits

/-!
# Products of affine schemes and generators of their global sections

The product of two affine schemes over the terminal scheme is the spectrum of
the tensor product over the integers. Products of generating sections containing
one generate its ring of global sections.
-/

noncomputable section

set_option relaxedAutoImplicit false
set_option backward.isDefEq.respectTransparency false

universe u

open CategoryTheory Limits CommRingCat
open scoped TensorProduct

namespace AlgebraicGeometry

attribute [local instance] ULift.algebra'

variable (firstRing secondRing : Type u) [CommRing firstRing] [CommRing secondRing]

/-- `Spec (firstRing ⊗[ULift ℤ] secondRing)`, with the two maps induced by `firstFamily ↦ firstFamily ⊗ₜ 1` and `secondFamily ↦ 1 ⊗ₜ secondFamily`, is the
fibre product of `Spec firstRing` and `Spec secondRing` over the terminal scheme. -/
theorem isPullback_terminalFrom_spec :
    IsPullback (Spec.map (ofHom (Algebra.TensorProduct.includeLeftRingHom
        (R := ULift.{u} ℤ) (A := firstRing) (B := secondRing))))
      (Spec.map (ofHom (Algebra.TensorProduct.includeRight (R := ULift.{u} ℤ)
        (A := firstRing) (B := secondRing)).toRingHom))
      (terminal.from (Spec (.of firstRing))) (terminal.from (Spec (.of secondRing))) := by
  have square : IsPullback (Spec.map (ofHom (Algebra.TensorProduct.includeLeftRingHom
      (R := ULift.{u} ℤ) (A := firstRing) (B := secondRing))))
      (Spec.map (ofHom (Algebra.TensorProduct.includeRight (R := ULift.{u} ℤ)
        (A := firstRing) (B := secondRing)).toRingHom))
      (Spec.map (ofHom (algebraMap (ULift.{u} ℤ) firstRing)))
      (Spec.map (ofHom (algebraMap (ULift.{u} ℤ) secondRing))) := ?_
  · exact square.of_isTerminal specULiftZIsTerminal terminalIsTerminal
  refine IsPullback.of_iso_pullback ⟨?_⟩ (pullbackSpecIso (ULift.{u} ℤ) firstRing secondRing).symm
    (pullbackSpecIso_inv_fst ..) (pullbackSpecIso_inv_snd ..)
  rw [← Spec.map_comp, ← Spec.map_comp]
  congr 1
  ext firstElement
  simp [Algebra.TensorProduct.algebraMap_def]

/-- The fibre product of `Spec firstRing` and `Spec secondRing` over the terminal scheme is
`Spec (firstRing ⊗[ULift ℤ] secondRing)`. -/
private def pullbackTerminalSpecIso :
    pullback (terminal.from (Spec (.of firstRing))) (terminal.from (Spec (.of secondRing))) ≅
      Spec (.of (firstRing ⊗[ULift.{u} ℤ] secondRing)) :=
  (isPullback_terminalFrom_spec firstRing secondRing).isoPullback.symm

/-- The composition of the inverse of `pullbackTerminalSpecIso firstRing secondRing` with the first projection is
`Spec.map` of the ring morphism `firstFamily ↦ firstFamily ⊗ₜ 1`. -/
@[reassoc (attr := simp)]
private lemma pullbackTerminalSpecIso_inv_fst :
    (pullbackTerminalSpecIso firstRing secondRing).inv ≫ pullback.fst _ _ =
      Spec.map (ofHom (Algebra.TensorProduct.includeLeftRingHom (R := ULift.{u} ℤ))) :=
  (isPullback_terminalFrom_spec firstRing secondRing).isoPullback_hom_fst

/-- The composition of the inverse of `pullbackTerminalSpecIso firstRing secondRing` with the second projection is
`Spec.map` of the ring morphism `secondFamily ↦ 1 ⊗ₜ secondFamily`. -/
@[reassoc (attr := simp)]
private lemma pullbackTerminalSpecIso_inv_snd :
    (pullbackTerminalSpecIso firstRing secondRing).inv ≫ pullback.snd _ _ =
      Spec.map (ofHom (Algebra.TensorProduct.includeRight (R := ULift.{u} ℤ)
        (A := firstRing) (B := secondRing)).toRingHom) :=
  (isPullback_terminalFrom_spec firstRing secondRing).isoPullback_hom_snd

/-- The composition of `pullbackTerminalSpecIso firstRing secondRing` with `Spec.map` of the ring morphism
`firstFamily ↦ firstFamily ⊗ₜ 1` is the first projection. -/
@[reassoc (attr := simp)]
private lemma pullbackTerminalSpecIso_hom_fst :
    (pullbackTerminalSpecIso firstRing secondRing).hom ≫
        Spec.map (ofHom (Algebra.TensorProduct.includeLeftRingHom (R := ULift.{u} ℤ))) =
      pullback.fst _ _ := by
  rw [← pullbackTerminalSpecIso_inv_fst, Iso.hom_inv_id_assoc]

/-- The composition of `pullbackTerminalSpecIso firstRing secondRing` with `Spec.map` of the ring morphism
`secondFamily ↦ 1 ⊗ₜ secondFamily` is the second projection. -/
@[reassoc (attr := simp)]
private lemma pullbackTerminalSpecIso_hom_snd :
    (pullbackTerminalSpecIso firstRing secondRing).hom ≫
        Spec.map (ofHom (Algebra.TensorProduct.includeRight (R := ULift.{u} ℤ)
          (A := firstRing) (B := secondRing)).toRingHom) = pullback.snd _ _ := by
  rw [← pullbackTerminalSpecIso_inv_snd, Iso.hom_inv_id_assoc]

/-- **Global sections of a product of two affine schemes are generated by the products of the
pullbacks of generators of the two factors.** -/
theorem closure_range_mul_appTop_eq_top {firstRing secondRing : Type u} [CommRing firstRing] [CommRing secondRing]
    {sourceScheme : Scheme.{u}} {firstMap : sourceScheme ⟶ Spec (.of firstRing)} {secondMap : sourceScheme ⟶ Spec (.of secondRing)}
    (hP : IsPullback firstMap secondMap (terminal.from _) (terminal.from _))
    {firstIndex secondIndex : Type*} {firstFamily : firstIndex → firstRing} {secondFamily : secondIndex → secondRing}
    (first_generates : Subring.closure (Set.range firstFamily) = ⊤) (second_generates : Subring.closure (Set.range secondFamily) = ⊤)
    {firstUnitIndex : firstIndex} (first_one : firstFamily firstUnitIndex = 1) {secondUnitIndex : secondIndex} (second_one : secondFamily secondUnitIndex = 1) :
    Subring.closure (Set.range fun indices : firstIndex × secondIndex ↦
        ((Scheme.ΓSpecIso _).inv ≫ firstMap.appTop).hom (firstFamily indices.1) *
          ((Scheme.ΓSpecIso _).inv ≫ secondMap.appTop).hom (secondFamily indices.2)) = ⊤ := by
  set identification : sourceScheme ≅ Spec (.of (firstRing ⊗[ULift.{u} ℤ] secondRing)) :=
    hP.isoPullback ≪≫ pullbackTerminalSpecIso firstRing secondRing with he
  set sectionMap : CommRingCat.of (firstRing ⊗[ULift.{u} ℤ] secondRing) ⟶ Γ(sourceScheme, ⊤) :=
    (Scheme.ΓSpecIso _).inv ≫ identification.hom.appTop with hφ
  have hfst : identification.hom ≫ Spec.map (ofHom (Algebra.TensorProduct.includeLeftRingHom
      (R := ULift.{u} ℤ) (A := firstRing) (B := secondRing))) = firstMap := by
    rw [he, Iso.trans_hom, Category.assoc, pullbackTerminalSpecIso_hom_fst,
      IsPullback.isoPullback_hom_fst]
  have hsnd : identification.hom ≫ Spec.map (ofHom (Algebra.TensorProduct.includeRight
      (R := ULift.{u} ℤ) (A := firstRing) (B := secondRing)).toRingHom) = secondMap := by
    rw [he, Iso.trans_hom, Category.assoc, pullbackTerminalSpecIso_hom_snd,
      IsPullback.isoPullback_hom_snd]
  have hA : ∀ firstElement : firstRing, ((Scheme.ΓSpecIso _).inv ≫ firstMap.appTop).hom firstElement =
      sectionMap.hom (firstElement ⊗ₜ[ULift.{u} ℤ] 1) := by
    intro firstElement
    rw [← hfst, Scheme.Hom.comp_appTop, ← Category.assoc,
      ← Scheme.ΓSpecIso_inv_naturality, Category.assoc, ← hφ]
    rfl
  have hB : ∀ secondElement : secondRing, ((Scheme.ΓSpecIso _).inv ≫ secondMap.appTop).hom secondElement =
      sectionMap.hom (1 ⊗ₜ[ULift.{u} ℤ] secondElement) := by
    intro secondElement
    rw [← hsnd, Scheme.Hom.comp_appTop, ← Category.assoc,
      ← Scheme.ΓSpecIso_inv_naturality, Category.assoc, ← hφ]
    rfl
  have hiso : IsIso sectionMap := by rw [hφ]; infer_instance
  have hsurj : Function.Surjective sectionMap.hom :=
    ((ConcreteCategory.isIso_iff_bijective sectionMap).mp hiso).2
  have hrange : ∀ indices : firstIndex × secondIndex,
      ((Scheme.ΓSpecIso _).inv ≫ firstMap.appTop).hom (firstFamily indices.1) *
        ((Scheme.ΓSpecIso _).inv ≫ secondMap.appTop).hom (secondFamily indices.2) =
      sectionMap.hom (firstFamily indices.1 ⊗ₜ[ULift.{u} ℤ] secondFamily indices.2) := by
    intro indices
    rw [hA, hB, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
  simp only [hrange]
  rw [show (Set.range fun indices : firstIndex × secondIndex ↦ sectionMap.hom (firstFamily indices.1 ⊗ₜ[ULift.{u} ℤ] secondFamily indices.2)) =
      sectionMap.hom '' (Set.range fun indices : firstIndex × secondIndex ↦ firstFamily indices.1 ⊗ₜ[ULift.{u} ℤ] secondFamily indices.2) by
    rw [← Set.range_comp]; rfl]
  rw [← RingHom.map_closure, Algebra.TensorProduct.closure_range_tmul_eq_top first_generates second_generates first_one second_one]
  ext element
  simp only [Subring.mem_map, Subring.mem_top, iff_true, true_and]
  exact hsurj element

end AlgebraicGeometry
