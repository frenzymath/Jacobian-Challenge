import Jacobian.RingTheory.GradedAlgebra.HomogeneousLocalization
import Mathlib.RingTheory.FiniteType
import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal
import Jacobian.RingTheory.MvPolynomial.Homogeneous
import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# Standard affine charts of homogeneous polynomial rings

The degree-zero part of the localization at a variable is the polynomial algebra
 in the ratios of the other indeterminates to that variable. Dehomogenization gives
 the explicit inverse isomorphism.
-/

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u

namespace MvPolynomial

section GradeZero

attribute [local instance] MvPolynomial.gradedAlgebra

variable (indeterminates : Type*) (baseRing : Type*) [CommRing baseRing]

/-- The irrelevant ideal of the total-degree grading on `R[X]` is the ideal generated by the
indeterminates. -/
theorem toIdeal_irrelevant_homogeneousSubmodule :
    (HomogeneousIdeal.irrelevant (homogeneousSubmodule indeterminates baseRing)).toIdeal =
      Ideal.span (Set.range (X : indeterminates → MvPolynomial indeterminates baseRing)) := by
  have h1 : Ideal.span (Set.range (X : indeterminates → MvPolynomial indeterminates baseRing)) = idealOfVars indeterminates baseRing ^ 1 :=
    (pow_one _).symm
  ext polynomial
  rw [h1, mem_pow_idealOfVars_iff']
  simp only [HomogeneousIdeal.toIdeal_irrelevant, RingHom.mem_ker,
    GradedRing.projZeroRingHom_apply]
  rw [show ((DirectSum.decompose (homogeneousSubmodule indeterminates baseRing) polynomial 0 : homogeneousSubmodule indeterminates baseRing 0) :
      MvPolynomial indeterminates baseRing) = homogeneousComponent 0 polynomial from decomposition.decompose'_apply polynomial 0,
    homogeneousComponent_zero, C_eq_zero]
  refine ⟨fun h d hd ↦ ?_, fun h ↦ h 0 (by simp)⟩
  obtain rfl : d = 0 := by
    simpa [Nat.lt_one_iff, Finsupp.degree_eq_zero_iff] using hd
  exact h

end GradeZero

lemma IsHomogeneous.eval₂Hom_const_mul {indeterminates baseRing targetRing : Type*} [CommSemiring baseRing]
    [CommSemiring targetRing] {polynomial : MvPolynomial indeterminates baseRing} {degree : ℕ} (hφ : polynomial.IsHomogeneous degree) (coefficientMap : baseRing →+* targetRing) (scalar : targetRing)
    (values : indeterminates → targetRing) : eval₂Hom coefficientMap (fun index ↦ scalar * values index) polynomial = scalar ^ degree * eval₂Hom coefficientMap values polynomial := by
  classical
  simp only [coe_eval₂Hom, eval₂_eq]
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun exponent hs ↦ ?_
  rw [Finset.prod_congr rfl fun index _ ↦ mul_pow scalar (values index) (exponent index), Finset.prod_mul_distrib,
    Finset.prod_pow_eq_pow_sum, ← hφ.degree_eq_sum_deg_support hs]
  ring

/-- Evaluating a polynomial that is homogeneous of degree `n` at `c • g` gives `c ^ n` times
its value at `g`. The `eval₂` form of `MvPolynomial.IsHomogeneous.eval₂Hom_const_mul`. -/
theorem IsHomogeneous.eval₂_const_mul {indeterminates baseRing targetRing : Type*} [CommSemiring baseRing] [CommSemiring targetRing]
    {polynomial : MvPolynomial indeterminates baseRing} {degree : ℕ} (hφ : polynomial.IsHomogeneous degree) (coefficientMap : baseRing →+* targetRing) (scalar : targetRing) (values : indeterminates → targetRing) :
    _root_.MvPolynomial.eval₂ coefficientMap (fun coordinate ↦ scalar * values coordinate) polynomial = scalar ^ degree * _root_.MvPolynomial.eval₂ coefficientMap values polynomial :=
  hφ.eval₂Hom_const_mul coefficientMap scalar values

/-- Every variable is homogeneous of degree one for the total-degree grading. -/
lemma X_mem_homogeneousSubmodule_one (baseRing : Type*) [CommSemiring baseRing] {indeterminates : Type*} (index : indeterminates) :
    X index ∈ homogeneousSubmodule indeterminates baseRing 1 :=
  isHomogeneous_X baseRing index

section Ratio

attribute [local instance] MvPolynomial.gradedAlgebra

variable (baseRing : Type*) [CommRing baseRing] {indeterminates : Type*}

/-- The ratio `Xₖ / Xᵢ` of two indeterminates, as an element of the degree-zero part
`(R[Xⱼ]_{Xᵢ})₀` of the localization of `R[Xⱼ]` at `Xᵢ`. These ratios are the affine
coordinates of the standard chart `D₊(Xᵢ)` of a projective space. -/
noncomputable def awayXRatio (coordinate otherIndex : indeterminates) :
    HomogeneousLocalization.Away (homogeneousSubmodule indeterminates baseRing) (X coordinate) :=
  HomogeneousLocalization.Away.mk _ (X_mem_homogeneousSubmodule_one baseRing coordinate) 1 (X otherIndex)
    (by simpa using X_mem_homogeneousSubmodule_one baseRing otherIndex)

/-- The element `Xₖ / Xᵢ` exhibiting `(R[X]_{XᵢXₖ})₀` as a localization of `(R[X]_{Xᵢ})₀` is the
ratio `Xₖ / Xᵢ`. -/
lemma isLocalizationElem_X (coordinate otherIndex : indeterminates) :
    HomogeneousLocalization.Away.isLocalizationElem
        (X_mem_homogeneousSubmodule_one baseRing coordinate) (X_mem_homogeneousSubmodule_one baseRing otherIndex) =
      awayXRatio baseRing coordinate otherIndex := by
  apply HomogeneousLocalization.val_injective
  simp [HomogeneousLocalization.Away.val_mk, awayXRatio]

@[simp]
lemma awayXRatio_self (coordinate : indeterminates) : awayXRatio baseRing coordinate coordinate = 1 :=
  HomogeneousLocalization.Away.mk_self _ _ _

end Ratio

section Chart

attribute [local instance] MvPolynomial.gradedAlgebra

variable (baseRing : Type*) [CommRing baseRing] {indeterminates : Type*} [DecidableEq indeterminates] (coordinate : indeterminates)

/-- Dehomogenisation with respect to the variable `Xᵢ`: the `R`-algebra map
`R[Xⱼ : j ∈ σ] → R[Yⱼ : j ≠ i]` sending `Xᵢ` to `1` and `Xⱼ` to `Yⱼ` for `j ≠ i`. -/
noncomputable def dehomogenizeX : MvPolynomial indeterminates baseRing →ₐ[baseRing] MvPolynomial {index : indeterminates // index ≠ coordinate} baseRing :=
  aeval fun index ↦ if h : index = coordinate then 1 else X ⟨index, h⟩

@[simp]
lemma dehomogenizeX_X_self : dehomogenizeX baseRing coordinate (X coordinate) = 1 := by
  simp [dehomogenizeX]

@[simp]
lemma dehomogenizeX_X_of_ne {index : indeterminates} (h : index ≠ coordinate) : dehomogenizeX baseRing coordinate (X index) = X ⟨index, h⟩ := by
  simp [dehomogenizeX, h]

/-- The `R`-algebra map `R[Yⱼ : j ≠ i] → (R[Xⱼ]_{Xᵢ})₀` sending `Yⱼ` to the class of
`Xⱼ / Xᵢ`. This is the inverse of `homogeneousLocalizationAwayXEquiv`. -/
private noncomputable def toAwayX : MvPolynomial {index : indeterminates // index ≠ coordinate} baseRing →ₐ[baseRing]
    HomogeneousLocalization.Away (homogeneousSubmodule indeterminates baseRing) (X coordinate) :=
  aeval fun index ↦ HomogeneousLocalization.Away.mk _ (X_mem_homogeneousSubmodule_one baseRing coordinate) 1
    (X index.1) (by simpa using X_mem_homogeneousSubmodule_one baseRing index.1)

/-- `toAwayX` followed by the inclusion of `(R[Xⱼ]_{Xᵢ})₀` into the full localization
`R[Xⱼ]_{Xᵢ}`, where the computations below take place. -/
private noncomputable def valToAwayX :
    MvPolynomial {index : indeterminates // index ≠ coordinate} baseRing →+* Localization.Away (X coordinate : MvPolynomial indeterminates baseRing) :=
  (algebraMap (HomogeneousLocalization.Away (homogeneousSubmodule indeterminates baseRing) (X coordinate))
    (Localization.Away (X coordinate : MvPolynomial indeterminates baseRing))).comp (toAwayX baseRing coordinate).toRingHom

/-- Substituting `Xⱼ ↦ Xⱼ / Xᵢ` for all `j`, including `j = i`, factors through
dehomogenisation with respect to `Xᵢ`. -/
private lemma valToAwayX_comp_dehomogenizeX :
    (valToAwayX baseRing coordinate).comp (dehomogenizeX baseRing coordinate).toRingHom =
      eval₂Hom
        ((algebraMap (MvPolynomial indeterminates baseRing) (Localization.Away (X coordinate : MvPolynomial indeterminates baseRing))).comp C)
        (fun index : indeterminates ↦ IsLocalization.Away.invSelf
            (S := Localization.Away (X coordinate : MvPolynomial indeterminates baseRing)) (X coordinate : MvPolynomial indeterminates baseRing) *
          algebraMap (MvPolynomial indeterminates baseRing) (Localization.Away (X coordinate : MvPolynomial indeterminates baseRing)) (X index)) := by
  apply ringHom_ext
  · intro coefficient
    change valToAwayX baseRing coordinate (dehomogenizeX baseRing coordinate (C coefficient)) = _
    simp [valToAwayX, toAwayX, dehomogenizeX, Localization.mk_one_eq_algebraMap]
  · intro index
    change valToAwayX baseRing coordinate (dehomogenizeX baseRing coordinate (X index)) = _
    by_cases h : index = coordinate
    · subst h
      simp [valToAwayX, IsLocalization.Away.invSelf]
    · rw [dehomogenizeX_X_of_ne baseRing coordinate h]
      simp only [valToAwayX, toAwayX, RingHom.coe_comp, Function.comp_apply,
        AlgHom.toRingHom_eq_coe, RingHom.coe_coe, aeval_X,
        HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
        eval₂Hom_X', pow_one, IsLocalization.Away.invSelf, ← Localization.mk_eq_mk',
        ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]

/-- Substituting `Xⱼ ↦ Xⱼ / Xᵢ` into a form `a` of degree `n` gives `a / Xᵢ ^ n`. -/
private lemma valToAwayX_dehomogenizeX {degree : ℕ} {polynomial : MvPolynomial indeterminates baseRing}
    (ha : polynomial.IsHomogeneous degree) :
    valToAwayX baseRing coordinate (dehomogenizeX baseRing coordinate polynomial) =
      Localization.mk polynomial (⟨(X coordinate : MvPolynomial indeterminates baseRing) ^ degree, degree, rfl⟩ :
        Submonoid.powers (X coordinate : MvPolynomial indeterminates baseRing)) := by
  have h₁ : valToAwayX baseRing coordinate (dehomogenizeX baseRing coordinate polynomial) =
      ((valToAwayX baseRing coordinate).comp (dehomogenizeX baseRing coordinate).toRingHom) polynomial := rfl
  have h₂ : eval₂Hom
      ((algebraMap (MvPolynomial indeterminates baseRing) (Localization.Away (X coordinate : MvPolynomial indeterminates baseRing))).comp C)
      (fun index : indeterminates ↦ algebraMap (MvPolynomial indeterminates baseRing)
        (Localization.Away (X coordinate : MvPolynomial indeterminates baseRing)) (X index)) =
      algebraMap (MvPolynomial indeterminates baseRing) (Localization.Away (X coordinate : MvPolynomial indeterminates baseRing)) :=
    ringHom_ext (fun coefficient ↦ by simp) (fun index ↦ by simp)
  rw [h₁, valToAwayX_comp_dehomogenizeX baseRing coordinate, IsHomogeneous.eval₂Hom_const_mul ha, h₂]
  simp [IsLocalization.Away.invSelf, ← Localization.mk_eq_mk',
    ← Localization.mk_one_eq_algebraMap, Localization.mk_pow, Localization.mk_mul]

/-- Dehomogenising a form of degree `n` and homogenising back recovers the class of
`a / Xᵢ ^ n`. -/
private lemma toAwayX_dehomogenizeX (degree : ℕ) (polynomial : MvPolynomial indeterminates baseRing)
    (ha : polynomial ∈ homogeneousSubmodule indeterminates baseRing (degree • 1)) :
    toAwayX baseRing coordinate (dehomogenizeX baseRing coordinate polynomial) =
      HomogeneousLocalization.Away.mk _ (X_mem_homogeneousSubmodule_one baseRing coordinate) degree polynomial ha := by
  apply HomogeneousLocalization.val_injective _
  rw [HomogeneousLocalization.Away.val_mk]
  exact valToAwayX_dehomogenizeX baseRing coordinate (by simpa using ha)

/-- The ring map `(R[Xⱼ]_{Xᵢ})₀ → R[Yⱼ : j ≠ i]` induced by dehomogenisation, which sends
`Xᵢ` to the unit `1`. -/
private noncomputable def ofAwayXRingHom :
    HomogeneousLocalization.Away (homogeneousSubmodule indeterminates baseRing) (X coordinate) →+*
      MvPolynomial {index : indeterminates // index ≠ coordinate} baseRing :=
  (Localization.awayLift (dehomogenizeX baseRing coordinate).toRingHom (X coordinate) (by simp)).comp
    (algebraMap (HomogeneousLocalization.Away (homogeneousSubmodule indeterminates baseRing) (X coordinate))
      (Localization.Away (X coordinate : MvPolynomial indeterminates baseRing)))

/-- `ofAwayXRingHom` sends the class of `a / Xᵢ ^ n` to the dehomogenisation of `a`. -/
private lemma ofAwayXRingHom_awayMk (degree : ℕ) (polynomial : MvPolynomial indeterminates baseRing)
    (ha : polynomial ∈ homogeneousSubmodule indeterminates baseRing (degree • 1)) :
    ofAwayXRingHom baseRing coordinate (HomogeneousLocalization.Away.mk _
      (X_mem_homogeneousSubmodule_one baseRing coordinate) degree polynomial ha) = dehomogenizeX baseRing coordinate polynomial := by
  rw [ofAwayXRingHom, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
    HomogeneousLocalization.Away.val_mk, Localization.awayLift_mk (v := 1) (hv := by simp)]
  simp

omit [DecidableEq indeterminates] in
/-- The structure map of `(R[Xⱼ]_{Xᵢ})₀` as an `R`-algebra is the class of `C r / Xᵢ ^ 0`. -/
private lemma awayMk_zero_C (coefficient : baseRing) (h) :
    HomogeneousLocalization.Away.mk (homogeneousSubmodule indeterminates baseRing)
        (X_mem_homogeneousSubmodule_one baseRing coordinate) 0 (C coefficient) h =
      algebraMap baseRing (HomogeneousLocalization.Away (homogeneousSubmodule indeterminates baseRing) (X coordinate)) coefficient := by
  apply HomogeneousLocalization.val_injective _
  rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_algebraMap]
  simp only [algebraMap_eq, pow_zero]
  rfl

/-- `ofAwayXRingHom` as a map of `R`-algebras. -/
private noncomputable def ofAwayX :
    HomogeneousLocalization.Away (homogeneousSubmodule indeterminates baseRing) (X coordinate) →ₐ[baseRing]
      MvPolynomial {index : indeterminates // index ≠ coordinate} baseRing where
  __ := ofAwayXRingHom baseRing coordinate
  commutes' coefficient := by
    change ofAwayXRingHom baseRing coordinate (algebraMap baseRing _ coefficient) = _
    rw [← awayMk_zero_C baseRing coordinate coefficient (by simp), ofAwayXRingHom_awayMk]
    simp [dehomogenizeX, algebraMap_eq]

/-- **The standard affine chart of projective space is an affine space**, algebraically: the
degree-zero part of the localization of the polynomial ring `R[Xⱼ : j ∈ σ]`, graded by total
degree, away from the variable `Xᵢ`, is the polynomial ring `R[Yⱼ : j ≠ i]`, via
`Yⱼ ↦ Xⱼ / Xᵢ`. -/
@[no_expose]
noncomputable def homogeneousLocalizationAwayXEquiv :
    HomogeneousLocalization.Away (homogeneousSubmodule indeterminates baseRing) (X coordinate) ≃ₐ[baseRing]
      MvPolynomial {index : indeterminates // index ≠ coordinate} baseRing :=
  AlgEquiv.ofAlgHom (ofAwayX baseRing coordinate) (toAwayX baseRing coordinate)
    (by
      refine algHom_ext fun index ↦ ?_
      change ofAwayXRingHom baseRing coordinate (toAwayX baseRing coordinate (X index)) = _
      rw [toAwayX, aeval_X, ofAwayXRingHom_awayMk, dehomogenizeX_X_of_ne baseRing coordinate index.2]
      simp)
    (by
      refine AlgHom.ext fun z ↦ ?_
      obtain ⟨degree, polynomial, ha, rfl⟩ :=
        HomogeneousLocalization.Away.mk_surjective _ (X_mem_homogeneousSubmodule_one baseRing coordinate) z
      change toAwayX baseRing coordinate (ofAwayXRingHom baseRing coordinate _) = _
      rw [ofAwayXRingHom_awayMk, toAwayX_dehomogenizeX]
      rfl)

/-- The isomorphism sends the class of `a / Xᵢ ^ n`, for `a` a form of degree `n`, to the
dehomogenisation of `a`. -/
@[simp]
lemma homogeneousLocalizationAwayXEquiv_awayMk (degree : ℕ) (polynomial : MvPolynomial indeterminates baseRing)
    (ha : polynomial ∈ homogeneousSubmodule indeterminates baseRing (degree • 1)) :
    homogeneousLocalizationAwayXEquiv baseRing coordinate
        (HomogeneousLocalization.Away.mk _ (X_mem_homogeneousSubmodule_one baseRing coordinate) degree polynomial ha) =
      dehomogenizeX baseRing coordinate polynomial :=
  ofAwayXRingHom_awayMk baseRing coordinate degree polynomial ha

/-- The inverse isomorphism sends `Yⱼ` to the class of `Xⱼ / Xᵢ`. -/
@[simp]
lemma homogeneousLocalizationAwayXEquiv_symm_X (index : {index : indeterminates // index ≠ coordinate}) :
    (homogeneousLocalizationAwayXEquiv baseRing coordinate).symm (X index) =
      HomogeneousLocalization.Away.mk _ (X_mem_homogeneousSubmodule_one baseRing coordinate) 1 (X index.1)
        (by simpa using X_mem_homogeneousSubmodule_one baseRing index.1) := by
  rw [AlgEquiv.symm_apply_eq, homogeneousLocalizationAwayXEquiv_awayMk,
    dehomogenizeX_X_of_ne baseRing coordinate index.2]

/-- The class of `Xᵢ / Xᵢ` is sent to `1`. -/
lemma homogeneousLocalizationAwayXEquiv_awayMk_X_self (h) :
    homogeneousLocalizationAwayXEquiv baseRing coordinate
        (HomogeneousLocalization.Away.mk _ (X_mem_homogeneousSubmodule_one baseRing coordinate) 1 (X coordinate) h) = 1 := by
  rw [homogeneousLocalizationAwayXEquiv_awayMk, dehomogenizeX_X_self]

/-- The class of `Xⱼ / Xᵢ` is sent to `Yⱼ`, for `j ≠ i`. -/
lemma homogeneousLocalizationAwayXEquiv_awayMk_X_of_ne {index : indeterminates} (hj : index ≠ coordinate) (h) :
    homogeneousLocalizationAwayXEquiv baseRing coordinate
        (HomogeneousLocalization.Away.mk _ (X_mem_homogeneousSubmodule_one baseRing coordinate) 1 (X index) h) =
      X ⟨index, hj⟩ := by
  rw [homogeneousLocalizationAwayXEquiv_awayMk, dehomogenizeX_X_of_ne baseRing coordinate hj]

/-- The isomorphism is a map of `R`-algebras: it sends the class of a constant `r` to `C r`. -/
lemma homogeneousLocalizationAwayXEquiv_algebraMap (coefficient : baseRing) :
    homogeneousLocalizationAwayXEquiv baseRing coordinate
      (algebraMap baseRing (HomogeneousLocalization.Away (homogeneousSubmodule indeterminates baseRing) (X coordinate)) coefficient) = C coefficient := by
  rw [AlgEquiv.commutes, algebraMap_eq]

end Chart




end MvPolynomial
