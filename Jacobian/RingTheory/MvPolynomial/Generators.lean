import Jacobian.RingTheory.MvPolynomial.HomogeneousCharts

/-!
# Ring generators of polynomial rings and homogeneous affine charts

If every coefficient is an integer, the variables generate the polynomial
ring, and the standard affine chart is generated by its coordinate ratios.
-/

namespace MvPolynomial

/-- Variables generate the polynomial ring as a ring when all coefficients are integers. -/
theorem closure_range_X_eq_top (coordinates : Type*) {baseRing : Type*} [CommRing baseRing]
    (integer_surjective : Function.Surjective ((↑) : ℤ → baseRing)) :
    Subring.closure (Set.range (X : coordinates → MvPolynomial coordinates baseRing)) = ⊤ := by
  have key : ∀ polynomial : MvPolynomial coordinates baseRing,
      polynomial ∈ Subring.closure (Set.range (X : coordinates → MvPolynomial coordinates baseRing)) := by
    intro polynomial
    induction polynomial using MvPolynomial.induction_on with
    | C coefficient =>
        obtain ⟨integer, rfl⟩ := integer_surjective coefficient
        rw [map_intCast]
        exact intCast_mem _ integer
    | add polynomial otherPolynomial membership otherMembership => exact add_mem membership otherMembership
    | mul_X polynomial coordinate membership => exact mul_mem membership (Subring.subset_closure ⟨coordinate, rfl⟩)
  exact le_antisymm le_top fun polynomial _ ↦ key polynomial


attribute [local instance] MvPolynomial.gradedAlgebra

/-- Coordinate ratios generate a standard homogeneous chart when all coefficients are integers. -/
theorem closure_range_awayXRatio_eq_top (baseRing : Type*) [CommRing baseRing] {coordinates : Type*}
    (integer_surjective : Function.Surjective ((↑) : ℤ → baseRing)) (coordinate : coordinates) :
    Subring.closure (Set.range (awayXRatio baseRing coordinate)) = ⊤ := by
  classical
  set coordinateMap := (homogeneousLocalizationAwayXEquiv baseRing coordinate).toRingEquiv.toRingHom with hEdef
  have hE : ∀ otherCoordinate : coordinates, coordinateMap (awayXRatio baseRing coordinate otherCoordinate) = dehomogenizeX baseRing coordinate (X otherCoordinate) :=
    fun otherCoordinate ↦ homogeneousLocalizationAwayXEquiv_awayMk baseRing coordinate 1 (X otherCoordinate) _
  have himg : Subring.map coordinateMap (Subring.closure (Set.range (awayXRatio baseRing coordinate))) = ⊤ := by
    rw [RingHom.map_closure, ← top_le_iff, ← closure_range_X_eq_top {chartCoordinate : coordinates // chartCoordinate ≠ coordinate} integer_surjective]
    refine Subring.closure_le.mpr ?_
    rintro _ ⟨chartCoordinate, rfl⟩
    exact Subring.subset_closure ⟨awayXRatio baseRing coordinate chartCoordinate.1, ⟨chartCoordinate.1, rfl⟩, by
      rw [hE, dehomogenizeX_X_of_ne baseRing coordinate chartCoordinate.2]⟩
  have hinj : Function.Injective coordinateMap := (homogeneousLocalizationAwayXEquiv baseRing coordinate).injective
  have equality := congrArg (Subring.comap coordinateMap) himg
  rwa [Subring.comap_map_eq_self_of_injective hinj, Subring.comap_top] at equality

end MvPolynomial
