import Jacobian.RingTheory.RegularLocalRing.Generators
import Jacobian.RingTheory.RegularLocalRing.Localization
import Mathlib.FieldTheory.IsAlgClosed.Basic
import Mathlib.RingTheory.Jacobson.Ring
import Mathlib.RingTheory.LocalRing.ResidueField.Ideal
import Mathlib.RingTheory.RegularLocalRing.Polynomial
import Mathlib.RingTheory.Smooth.Field
import Mathlib.RingTheory.Smooth.Local
import Mathlib.RingTheory.Smooth.Locus

/-!
# Smoothness at regular local rings

A regular local quotient of a formally smooth regular local algebra is formally
smooth when its residue field is formally smooth. This gives the regular-local
criterion for smoothness of finite type algebras over perfect fields.
-/

noncomputable section

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open IsLocalRing


open KaehlerDifferential TensorProduct in
/-- Let `B → S` be a surjection of regular local `k`-algebras, where `B` is formally smooth over
`k` with `Ω[B⁄k]` finite free (for instance a localization of a polynomial ring), and suppose that
the residue field of `S` is formally smooth over `k`. Then `S` is formally smooth over `k`
(Stacks `00TV`).

The kernel `I` of `B → S` is generated by elements `f₁, …, f_c` independent in `𝔪 / 𝔪²`
(`IsRegularLocalRing.exists_span_eq_of_isRegularLocalRing_quotient`), and `𝔪 / 𝔪² → κ ⊗ Ω[B⁄k]` is
injective since `κ` is formally smooth over `k`, so the `1 ⊗ d fᵢ` are independent and the
Jacobian criterion `Algebra.FormallySmooth.iff_injective_cotangentComplexBaseChange` applies. -/
theorem Algebra.FormallySmooth.of_isRegularLocalRing_of_surjective {k B S : Type*}
    [CommRing k] [CommRing B] [CommRing S] [Algebra k B] [Algebra k S] [Algebra B S]
    [IsScalarTower k B S] [Algebra.FormallySmooth k B] [Module.Free B Ω[B⁄k]]
    [Module.Finite B Ω[B⁄k]] [IsRegularLocalRing B] [IsRegularLocalRing S]
    [Algebra.FormallySmooth k (ResidueField S)] (h : Function.Surjective (algebraMap B S)) :
    Algebra.FormallySmooth k S := by
  classical
  set I := RingHom.ker (algebraMap B S)
  set κ := ResidueField S
  have := IsLocalHom.of_surjective (algebraMap B S) h
  have hI : I ≤ maximalIdeal B := fun x hx ↦ by
    rw [← (maximalIdeal_comap (algebraMap B S)), Ideal.mem_comap, RingHom.mem_ker.1 hx]
    exact zero_mem _
  have : IsRegularLocalRing (B ⧸ I) :=
    .of_ringEquiv (RingHom.quotientKerEquivOfSurjective h).symm
  obtain ⟨s, hsfin, hspan, hs⟩ :=
    IsRegularLocalRing.exists_span_eq_of_isRegularLocalRing_quotient I hI
  have hsI (x : s) : (x : B) ∈ I := hspan ▸ Ideal.subset_span ⟨x, x.2, rfl⟩
  have hκ (x : B) : algebraMap B κ x = 0 ↔ x ∈ maximalIdeal B := by
    rw [IsScalarTower.algebraMap_apply B S κ, ResidueField.algebraMap_eq, residue_eq_zero_iff,
      ← Ideal.mem_comap, maximalIdeal_comap]
  have hκsurj : Function.Surjective (algebraMap B κ) := by
    rw [IsScalarTower.algebraMap_eq B S κ]
    exact residue_surjective.comp h
  rw [Algebra.FormallySmooth.iff_injective_cotangentComplexBaseChange B κ h
    (IsNoetherian.noetherian I) (by intro x hx; simpa [κ] using hx)]
  set Φ := cotangentComplexBaseChange k S B κ
  let g : s → κ ⊗[B] I := fun x ↦ 1 ⊗ₜ ⟨x, hsI x⟩
  have hgspan : Submodule.span B (Set.range fun x : s ↦ (⟨x, hsI x⟩ : I)) = ⊤ := by
    apply Submodule.map_injective_of_injective I.injective_subtype
    rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype, ← Set.range_comp]
    conv_rhs => rw [← hspan]
    congr 1
    ext
    simp
  have hG : Function.Surjective (Finsupp.linearCombination κ g) := by
    rw [← LinearMap.range_eq_top, Finsupp.range_linearCombination]
    refine Submodule.eq_top_iff'.2 fun z ↦ ?_
    induction z using TensorProduct.induction_on with
    | zero => exact zero_mem _
    | add x y hx hy => exact add_mem hx hy
    | tmul a i =>
      rw [show a ⊗ₜ[B] i = a • (1 ⊗ₜ[B] i) by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]]
      refine Submodule.smul_mem _ a ?_
      have hi : i ∈ Submodule.span B (Set.range fun x : s ↦ (⟨x, hsI x⟩ : I)) := hgspan ▸ trivial
      induction hi using Submodule.span_induction with
      | mem y hy =>
        obtain ⟨x, rfl⟩ := hy
        exact Submodule.subset_span ⟨x, rfl⟩
      | zero => rw [TensorProduct.tmul_zero]; exact zero_mem _
      | add y z _ _ hy hz => rw [TensorProduct.tmul_add]; exact add_mem hy hz
      | smul b y _ hy =>
        rw [TensorProduct.tmul_smul, ← algebraMap_smul κ b]
        exact Submodule.smul_mem _ _ hy
  have hinj : Function.Injective (kerCotangentToTensor k B κ) :=
    (Algebra.FormallySmooth.kerCotangentToTensor_injective_iff hκsurj).2 inferInstance
  have hli : LinearIndependent κ (Φ ∘ g) := by
    have := hsfin.fintype
    rw [Fintype.linearIndependent_iff]
    intro c hc x₀
    choose c' hc' using fun x ↦ hκsurj (c x)
    have hterm (x : s) : c x • (Φ ∘ g) x = 1 ⊗ₜ D k B (c' x * x) := by
      have hx0 : x.1.1 • (1 : κ) = 0 := by
        rw [Algebra.smul_def, mul_one]
        exact (hκ _).2 x.1.2
      rw [Function.comp_apply, cotangentComplexBaseChange_tmul, one_smul, kerToTensor_apply,
        ← hc', algebraMap_smul, ← TensorProduct.tmul_smul, Derivation.leibniz,
        TensorProduct.tmul_add, ← TensorProduct.smul_tmul (R := B) (x : B), hx0,
        TensorProduct.zero_tmul, add_zero]
    have hsum : ∑ x, c x • (Φ ∘ g) x = 1 ⊗ₜ D k B (∑ x : s, c' x * x) := by
      simp only [hterm, map_sum, TensorProduct.tmul_sum]
    set y := ∑ x : s, c' x * (x : B)
    have hy : y ∈ maximalIdeal B := sum_mem fun x _ ↦ Ideal.mul_mem_left _ _ x.1.2
    have hyker : y ∈ RingHom.ker (algebraMap B κ) := (hκ y).2 hy
    have h0 : kerCotangentToTensor k B κ ((RingHom.ker (algebraMap B κ)).toCotangent ⟨y, hyker⟩) =
        kerCotangentToTensor k B κ 0 := by
      rw [kerCotangentToTensor_toCotangent, map_zero, ← hsum]
      exact hc
    have h1 := (Ideal.toCotangent_eq_zero _ _).1 (hinj h0)
    have hker : RingHom.ker (algebraMap B κ) = maximalIdeal B := Ideal.ext hκ
    have h1' : y ∈ maximalIdeal B ^ 2 := hker ▸ h1
    have h2 : (maximalIdeal B).toCotangent ⟨y, hy⟩ = 0 :=
      (Ideal.toCotangent_eq_zero _ _).2 h1'
    have h3 : (maximalIdeal B).toCotangent ⟨y, hy⟩ =
        ∑ x : s, residue B (c' x) • (maximalIdeal B).toCotangent x := by
      have : (⟨y, hy⟩ : maximalIdeal B) = ∑ x : s, c' x • (x : maximalIdeal B) := by
        ext
        simp [y]
      rw [this, map_sum]
      refine Finset.sum_congr rfl fun x _ ↦ ?_
      rw [map_smul, ← ResidueField.algebraMap_eq, algebraMap_smul]
    rw [h3] at h2
    have := Fintype.linearIndependent_iff.1 hs (fun x ↦ residue B (c' x)) h2 x₀
    rw [residue_eq_zero_iff] at this
    rw [← hc', hκ]
    exact this
  have hΦG : Function.Injective (fun a ↦ Φ (Finsupp.linearCombination κ g a)) := by
    intro a b hab
    apply linearIndependent_iff_injective_finsuppLinearCombination.1 hli
    rw [← Finsupp.apply_linearCombination, ← Finsupp.apply_linearCombination]
    exact hab
  intro a b hab
  obtain ⟨a, rfl⟩ := hG a
  obtain ⟨b, rfl⟩ := hG b
  exact congrArg _ (hΦG hab)

/-- Let `A` be a finitely generated algebra over a field `k` and `q` a prime of `A` such that
`A_q` is a regular local ring whose residue field is formally smooth over `k` (e.g. `k` perfect).
Then `A_q` is formally smooth over `k`, i.e. `A` is smooth at `q` (Stacks `00TV`). -/
theorem Algebra.FormallySmooth.localization_of_isRegularLocalRing {k A : Type*} [Field k]
    [CommRing A] [Algebra k A] [Algebra.FiniteType k A] (q : Ideal A) [q.IsPrime]
    [IsRegularLocalRing (Localization.AtPrime q)]
    [Algebra.FormallySmooth k (ResidueField (Localization.AtPrime q))] :
    Algebra.FormallySmooth k (Localization.AtPrime q) := by
  obtain ⟨n, π, hπ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹_›
  let P := MvPolynomial (Fin n) k
  let := π.toRingHom.toAlgebra
  have : IsScalarTower k P A := IsScalarTower.of_algebraMap_eq' π.comp_algebraMap.symm
  let Q := q.comap (algebraMap P A)
  have : q.LiesOver Q := ⟨rfl⟩
  let := Localization.AtPrime.algebraOfLiesOver Q q
  have hsurj : Function.Surjective
      (algebraMap (Localization.AtPrime Q) (Localization.AtPrime q)) := by
    intro x
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl x
    obtain ⟨a', rfl⟩ := hπ a
    obtain ⟨s', hs'⟩ := hπ (s : A)
    have hs'Q : s' ∈ Q.primeCompl := by
      change algebraMap P A s' ∉ q
      exact hs' ▸ s.2
    refine ⟨IsLocalization.mk' _ a' ⟨s', hs'Q⟩, ?_⟩
    rw [Localization.AtPrime.IsLiesOverAlgebra.algebraMap_eq, Localization.localRingHom_mk']
    congr 1
    exact Subtype.ext hs'
  have : Algebra.FormallySmooth P (Localization.AtPrime Q) := .of_isLocalization Q.primeCompl
  have : Algebra.FormallySmooth k (Localization.AtPrime Q) := .comp k P _
  have : Module.Free (Localization.AtPrime Q) Ω[Localization.AtPrime Q⁄k] :=
    Module.free_of_flat_of_isLocalRing
  exact Algebra.FormallySmooth.of_isRegularLocalRing_of_surjective hsurj

/-- **Regular algebras over perfect fields are smooth.** A finitely generated algebra over a
perfect field `k` whose localizations at primes are regular local rings is smooth over `k`
(Stacks `00TV`). -/
theorem Algebra.Smooth.of_isRegularLocalRing {k A : Type*} [Field k] [PerfectField k]
    [CommRing A] [Algebra k A] [Algebra.FiniteType k A]
    (h : ∀ (q : Ideal A) [q.IsPrime], IsRegularLocalRing (Localization.AtPrime q)) :
    Algebra.Smooth k A := by
  have : Algebra.FinitePresentation k A := Algebra.FinitePresentation.of_finiteType.mp ‹_›
  refine ⟨?_, inferInstance⟩
  rw [← Algebra.smoothLocus_eq_univ_iff, Set.eq_univ_iff_forall]
  intro p
  have := h p.asIdeal
  have : Algebra.EssFiniteType k (ResidueField (Localization.AtPrime p.asIdeal)) :=
    inferInstanceAs (Algebra.EssFiniteType k (Localization.AtPrime p.asIdeal ⧸ _))
  exact Algebra.FormallySmooth.localization_of_isRegularLocalRing p.asIdeal

/-- **A finitely generated algebra over a field is smooth at a regular rational point.** Let `A`
be a finitely generated `k`-algebra and `q` a prime of `A` with residue field `k` such that `A_q`
is a regular local ring. Then `A` is smooth over `k` at `q`. -/
theorem Algebra.IsSmoothAt.of_isRegularLocalRing {k A : Type*} [Field k] [CommRing A]
    [Algebra k A] [Algebra.FiniteType k A] (q : Ideal A) [q.IsPrime]
    [IsRegularLocalRing (Localization.AtPrime q)]
    (hq : Function.Surjective (algebraMap k (ResidueField (Localization.AtPrime q)))) :
    Algebra.IsSmoothAt k q :=
  have : Algebra.FormallySmooth k (ResidueField (Localization.AtPrime q)) :=
    .of_equiv (AlgEquiv.ofBijective (Algebra.ofId k _) ⟨(algebraMap k _).injective, hq⟩)
  Algebra.FormallySmooth.localization_of_isRegularLocalRing q

/-- A finitely generated algebra over an algebraically closed field `k` is smooth at every
maximal ideal at which it is regular: the residue field is a finite extension of `k`, hence
equal to `k`. -/
theorem Algebra.IsSmoothAt.of_isRegularLocalRing_of_isAlgClosed {k A : Type*} [Field k]
    [IsAlgClosed k] [CommRing A] [Algebra k A] [Algebra.FiniteType k A] (q : Ideal A)
    [q.IsMaximal] [IsRegularLocalRing (Localization.AtPrime q)] : Algebra.IsSmoothAt k q := by
  refine Algebra.IsSmoothAt.of_isRegularLocalRing q ?_
  have : Algebra.FiniteType k q.ResidueField :=
    .of_surjective (IsScalarTower.toAlgHom k A q.ResidueField)
      q.algebraMap_residueField_surjective
  have : Module.Finite k q.ResidueField := finite_of_finite_type_of_isJacobsonRing k _
  exact (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k)).2

end
