import Mathlib.Algebra.TrivSqZeroExt.Basic
import Mathlib.RingTheory.DedekindDomain.Different
import Mathlib.RingTheory.Localization.NormTrace
import Jacobian.RingTheory.Kaehler.Trace

/-!
# Duality for the trace of differentials

Let `k` be a field, `R` an integrally closed `k`-domain with a `k`-derivation `D : R → R` and
`t ∈ R` with `D t = 1` (e.g. `R = k[t]`, `D = d/dt`), and `B` a Dedekind domain, finite free over
`R`, whose fraction field is separable over that of `R`. Suppose that `Ω_{B/k}` is locally
generated by one element and that the residue field extensions of `B/R` at the maximal ideals are
separable (e.g. `k` perfect and `B` of finite type over `k`). Then the trace derivation induces
an isomorphism `Ω_{B/k} ≅ Hom_R(B, R)`, `c da ↦ (b ↦ Tr(bC · D(A)))`
(`KaehlerDifferential.bijective_liftKaehlerDifferential_traceDerivation`).

For `R = k[t]` this says `Ω_{B/k} ≅ Hom_R(B, Ω_{R/k})`, the codifferent of `B/R` times `dt`: it
is the local form of Grothendieck duality `f^! Ω_{ℙ¹} ≅ Ω_X` for a finite flat morphism of smooth
curves `f : X → ℙ¹`.

## Proof

Locally at a maximal ideal `q` of `B` the extension is monogenic: there are `a ∈ B` and
`s ∈ R[a] \ q` with `s B ⊆ R[a]` (`exists_mem_adjoin_mul_mem_adjoin`). With `F` the minimal
polynomial of `a` over `R`, the Leibniz rule applied to `F(a) = 0` gives
`F'(a) δ(a) = -F^D(a) Tr` (`smul_traceDerivation_eq`), where `F^D` is `F` with `D` applied to the
coefficients, and by Euler's formula for the dual of `R[a]` every `φ ∈ Hom_R(B, R)` satisfies
`F'(a) φ = c Tr` for some `c ∈ B` (`exists_smul_eq_smul_trace`). Smoothness gives
`F'(a) ∉ q` or `F^D(a) ∉ q` (`derivative_or_derivCoeff_not_mem`): otherwise `dt` and `da` would
be independent in `Ω_{B/k} ⊗ κ(q)`. Hence some element of `B \ q` multiplies every `φ` into the
image, which is therefore everything.
-/


set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open Polynomial Algebra

namespace Polynomial

variable {k R : Type*} [CommRing k] [CommRing R] [Algebra k R]

/-- `F^D = ∑ᵢ D(fᵢ) Xⁱ`: the derivation `D` applied to the coefficients of `F`. -/
noncomputable def derivCoeff (D : Derivation k R R) (F : R[X]) : R[X] :=
  F.sum fun i c ↦ monomial i (D c)

lemma derivCoeff_add (D : Derivation k R R) (F G : R[X]) :
    derivCoeff D (F + G) = derivCoeff D F + derivCoeff D G :=
  sum_add_index _ _ _ (fun i ↦ by rw [D.map_zero, monomial_zero_right])
    fun i c c' ↦ by rw [D.map_add, map_add]

lemma derivCoeff_monomial (D : Derivation k R R) (n : ℕ) (c : R) :
    derivCoeff D (monomial n c) = monomial n (D c) :=
  sum_monomial_index _ _ (by rw [D.map_zero, monomial_zero_right])

end Polynomial

namespace KaehlerDifferential

attribute [local instance] precompModule precompModule_isScalarTower FractionRing.liftAlgebra
  FractionRing.isScalarTower_liftAlgebra Ideal.Quotient.field

variable {k R B : Type*} [Field k] [CommRing R] [IsDomain R] [Algebra k R] [CommRing B]
  [IsDomain B] [Algebra R B] [Algebra k B] [IsScalarTower k R B] [Module.Free R B]
  [Module.Finite R B] (D : Derivation k R R)

omit [IsDomain R] [IsDomain B] in
/-- `δ(r) = D(r) Tr` for `r ∈ R`. -/
lemma traceDerivation_algebraMap (r : R) :
    traceDerivation D (algebraMap R B r) =
      algebraMap R B (D r) • (Algebra.trace R B : B →ₗ[R] R) := by
  refine LinearMap.ext fun c ↦ ?_
  rw [traceDerivation_apply, traceDeriv_algebraMap, precompModule_smul_apply, ← Algebra.smul_def,
    LinearMap.map_smul, smul_eq_mul, smul_eq_mul, mul_comm]

omit [IsDomain R] [IsDomain B] in
/-- The trace derivation of a polynomial expression:
`δ(F(a)) = F'(a) δ(a) + F^D(a) Tr`. -/
lemma traceDerivation_aeval (F : R[X]) (a : B) :
    traceDerivation D (aeval a F) = aeval a (derivative F) • traceDerivation D a +
      aeval a (derivCoeff D F) • (Algebra.trace R B : B →ₗ[R] R) := by
  induction F using Polynomial.induction_on' with
  | add p q hp hq =>
    rw [map_add, map_add, hp, hq, derivative_add, map_add, add_smul, derivCoeff_add, map_add,
      add_smul]
    abel
  | monomial n c =>
    rw [aeval_monomial, Derivation.leibniz, Derivation.leibniz_pow, traceDerivation_algebraMap,
      derivative_monomial, aeval_monomial, derivCoeff_monomial, aeval_monomial, add_comm]
    simp only [smul_smul, ← Nat.cast_smul_eq_nsmul B, map_mul, map_natCast]
    rw [mul_comm (a ^ n), mul_assoc ((algebraMap R B) c), add_comm]


omit [IsDomain R] [IsDomain B] in
/-- `F'(a) δ(a) = -F^D(a) Tr` for a root `a` of `F`. -/
lemma smul_traceDerivation_eq {F : R[X]} {a : B} (hF : aeval a F = 0) :
    aeval a (derivative F) • traceDerivation D a =
      -(aeval a (derivCoeff D F) • (Algebra.trace R B : B →ₗ[R] R)) := by
  have := traceDerivation_aeval D F a
  rw [hF, map_zero] at this
  exact eq_neg_of_add_eq_zero_left this.symm

omit [Module.Free R B] in
/-- `Hom_R(B, R)` is a torsion-free `B`-module. -/
lemma eq_zero_of_smul_eq_zero {x : B} (hx : x ≠ 0) {φ : B →ₗ[R] R} (h : x • φ = 0) : φ = 0 := by
  have hne := Ideal.comap_ne_bot_of_integral_mem hx (Ideal.mem_span_singleton_self x)
    (Algebra.IsIntegral.isIntegral (R := R) x)
  obtain ⟨r, hr, hr0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
  obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp (Ideal.mem_comap.mp hr)
  refine LinearMap.ext fun c ↦ ?_
  have e : r * φ c = 0 := by
    rw [← smul_eq_mul, ← LinearMap.map_smul, Algebra.smul_def, ← hy, mul_comm y, mul_assoc,
      ← precompModule_smul_apply, h, LinearMap.zero_apply]
  exact (mul_eq_zero.mp e).resolve_left hr0



section FractionRing

variable (R B) in
lemma isLocalization_fractionRing [IsIntegrallyClosed B] :
    IsLocalization (Algebra.algebraMapSubmonoid B (nonZeroDivisors R)) (FractionRing B) := by
  have : IsIntegralClosure B R (FractionRing B) := IsIntegralClosure.of_isIntegrallyClosed _ _ _
  have : Algebra.IsAlgebraic (FractionRing R) (FractionRing B) :=
    isAlgebraic_of_isFractionRing R B ..
  exact IsIntegralClosure.isLocalization _ (FractionRing R) _ _

variable (R B) in
lemma finiteDimensional_fractionRing [IsIntegrallyClosed B] :
    FiniteDimensional (FractionRing R) (FractionRing B) := by
  have := isLocalization_fractionRing R B
  exact .of_isLocalization R B (nonZeroDivisors R)

lemma trace_algebraMap_fractionRing [IsIntegrallyClosed B] (b : B) :
    Algebra.trace (FractionRing R) (FractionRing B) (algebraMap B (FractionRing B) b) =
      algebraMap R (FractionRing R) (Algebra.trace R B b) := by
  have := isLocalization_fractionRing R B
  exact Algebra.trace_localization R (nonZeroDivisors R) b

/-- The trace of a separable extension is nonzero. -/
lemma trace_ne_zero [IsIntegrallyClosed B]
    [Algebra.IsSeparable (FractionRing R) (FractionRing B)] :
    (Algebra.trace R B : B →ₗ[R] R) ≠ 0 := by
  intro h
  have := isLocalization_fractionRing R B
  have := finiteDimensional_fractionRing R B
  obtain ⟨z, hz⟩ := Algebra.trace_surjective (FractionRing R) (FractionRing B) 1
  obtain ⟨⟨b, m⟩, hbz⟩ :=
    IsLocalization.mk'_surjective (Algebra.algebraMapSubmonoid B (nonZeroDivisors R)) z
  obtain ⟨r, hr, hrm⟩ := m.2
  have e := congrArg (Algebra.trace (FractionRing R) (FractionRing B))
    (IsLocalization.mk'_spec (FractionRing B) b m)
  simp only at hbz
  rw [hbz, ← hrm, ← IsScalarTower.algebraMap_apply,
    IsScalarTower.algebraMap_apply R (FractionRing R), mul_comm, ← Algebra.smul_def,
    LinearMap.map_smul, hz, trace_algebraMap_fractionRing,
    LinearMap.congr_fun h b, LinearMap.zero_apply, map_zero, smul_eq_mul, mul_one] at e
  exact nonZeroDivisors.ne_zero hr (IsFractionRing.injective R (FractionRing R) (e.trans
    (map_zero _).symm))

/-- The derivative of the minimal polynomial of an element of a separable extension does not
vanish at the element. -/
lemma aeval_derivative_minpoly_ne_zero [IsIntegrallyClosed R]
    [Algebra.IsSeparable (FractionRing R) (FractionRing B)] (a : B) :
    aeval a (derivative (minpoly R a)) ≠ 0 := by
  have hAx : IsIntegral R a := Algebra.IsIntegral.isIntegral a
  have hne₁ : aeval (algebraMap B (FractionRing B) a)
      (derivative (minpoly (FractionRing R) (algebraMap B (FractionRing B) a))) ≠ 0 :=
    (Algebra.IsSeparable.isSeparable _ _).aeval_derivative_ne_zero (minpoly.aeval _ _)
  rw [minpoly.isIntegrallyClosed_eq_field_fractions (FractionRing R) (FractionRing B) hAx,
    derivative_map, aeval_map_algebraMap, aeval_algebraMap_apply] at hne₁
  exact fun h ↦ hne₁ (by rw [h, map_zero])

end FractionRing

/-- The fraction field of `B` is generated by `a` if `B ⊆ R[a][1/s]`. -/
lemma adjoin_eq_top_of_mul_mem_adjoin [IsIntegrallyClosed B] {a s : B} (hs₀ : s ≠ 0)
    (hs : s ∈ Algebra.adjoin R {a}) (hsB : ∀ b, s * b ∈ Algebra.adjoin R {a}) :
    Algebra.adjoin (FractionRing R) {algebraMap B (FractionRing B) a} = ⊤ := by
  have := isLocalization_fractionRing R B
  have := finiteDimensional_fractionRing R B
  rw [← IntermediateField.adjoin_eq_top_iff]
  set E := IntermediateField.adjoin (FractionRing R) {algebraMap B (FractionRing B) a}
  have hadj (x : B) (hx : x ∈ Algebra.adjoin R {a}) : algebraMap B (FractionRing B) x ∈ E := by
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff.mp hx]
      exact IntermediateField.mem_adjoin_simple_self _ _
    | algebraMap r =>
      rw [← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply R (FractionRing R)]
      exact E.algebraMap_mem _
    | add x y _ _ hx hy => rw [map_add]; exact E.add_mem hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact E.mul_mem hx hy
  have hB (b : B) : algebraMap B (FractionRing B) b ∈ E := by
    have hs' : algebraMap B (FractionRing B) s ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective B _)).2 hs₀
    have : algebraMap B (FractionRing B) b =
        (algebraMap B (FractionRing B) s)⁻¹ * algebraMap B (FractionRing B) (s * b) := by
      rw [map_mul, inv_mul_cancel_left₀ hs']
    rw [this]
    exact E.mul_mem (E.inv_mem (hadj s hs)) (hadj _ (hsB b))
  refine eq_top_iff.2 fun z _ ↦ ?_
  obtain ⟨⟨b, m⟩, rfl⟩ :=
    IsLocalization.mk'_surjective (Algebra.algebraMapSubmonoid B (nonZeroDivisors R)) z
  have hm : algebraMap B (FractionRing B) (m : B) ≠ 0 :=
    (IsLocalization.map_units (FractionRing B) m).ne_zero
  simp only
  rw [(eq_div_iff hm).2 (IsLocalization.mk'_spec (FractionRing B) b m)]
  exact E.div_mem (hB b) (hB m)

/-- **Euler's formula.** If `B ⊆ R[a][1/s]`, then for every `φ ∈ Hom_R(B, R)` the functional
`F'(a) φ` is `c Tr` for some `c ∈ B`, where `F` is the minimal polynomial of `a` over `R`. -/
lemma exists_smul_eq_smul_trace [IsIntegrallyClosed R] [IsIntegrallyClosed B]
    [Algebra.IsSeparable (FractionRing R) (FractionRing B)] {a s : B}
    (hs₀ : s ≠ 0) (hs : s ∈ Algebra.adjoin R {a}) (hsB : ∀ b, s * b ∈ Algebra.adjoin R {a})
    (φ : B →ₗ[R] R) :
    ∃ c : B, aeval a (derivative (minpoly R a)) • φ = c • (Algebra.trace R B : B →ₗ[R] R) := by
  classical
  set K := FractionRing R
  set L := FractionRing B
  have := isLocalization_fractionRing R B
  have := finiteDimensional_fractionRing R B
  have hAx : IsIntegral R a := Algebra.IsIntegral.isIntegral a
  have hAxL : IsIntegral R (algebraMap B L a) := hAx.map (IsScalarTower.toAlgHom R B L)
  have hx := adjoin_eq_top_of_mul_mem_adjoin hs₀ hs hsB
  have hdual := traceForm_dualSubmodule_adjoin R K hx hAxL
  -- the derivative of the minimal polynomial
  have hF' : aeval (algebraMap B L a) (derivative (minpoly K (algebraMap B L a))) =
      algebraMap B L (aeval a (derivative (minpoly R a))) := by
    rw [minpoly.isIntegrallyClosed_eq_field_fractions K L hAx, derivative_map,
      aeval_map_algebraMap, aeval_algebraMap_apply]
  -- extend `φ` to `L`
  let b₀ := Module.Free.chooseBasis R B
  let bL := b₀.localizationLocalization K (nonZeroDivisors R) L
  let φK : L →ₗ[K] K := bL.constr K fun i ↦ algebraMap R K (φ (b₀ i))
  have hφK (x : B) : φK (algebraMap B L x) = algebraMap R K (φ x) := by
    have : (φK.restrictScalars R).comp (IsScalarTower.toAlgHom R B L).toLinearMap =
        (Algebra.linearMap R K).comp φ := by
      refine b₀.ext fun i ↦ ?_
      simp only [LinearMap.comp_apply, LinearMap.restrictScalars_apply,
        AlgHom.toLinearMap_apply, IsScalarTower.toAlgHom_apply, Algebra.linearMap_apply]
      rw [← Module.Basis.localizationLocalization_apply K (nonZeroDivisors R) L b₀ i,
        Module.Basis.constr_basis]
    exact LinearMap.congr_fun this x
  -- the dual element
  have hnd := traceForm_nondegenerate K L
  set y := ((traceForm K L).toDual hnd).symm φK
  have hy (z : L) : Algebra.trace K L (y * z) = φK z := by
    rw [← traceForm_apply]
    exact LinearMap.BilinForm.apply_toDual_symm_apply _ _
  have hymem : y ∈ (traceForm K L).dualSubmodule
      (Subalgebra.toSubmodule (Algebra.adjoin R {algebraMap B L a})) := by
    rw [LinearMap.BilinForm.mem_dualSubmodule]
    intro w hw
    rw [Subalgebra.mem_toSubmodule, ← IsScalarTower.coe_toAlgHom' R B L,
      ← AlgHom.map_adjoin_singleton] at hw
    obtain ⟨w', -, rfl⟩ := hw
    change Algebra.trace K L (y * algebraMap B L w') ∈ (1 : Submodule R K)
    rw [hy, hφK, Submodule.mem_one]
    exact ⟨_, rfl⟩
  rw [hdual, Submodule.mem_smul_pointwise_iff_exists] at hymem
  obtain ⟨w, hw, hwy⟩ := hymem
  rw [Subalgebra.mem_toSubmodule, ← IsScalarTower.coe_toAlgHom' R B L,
    ← AlgHom.map_adjoin_singleton] at hw
  obtain ⟨c, -, rfl⟩ := hw
  have hne : algebraMap B L (aeval a (derivative (minpoly R a))) ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective B L)).2 (aeval_derivative_minpoly_ne_zero a)
  have key (x : B) : y * algebraMap B L (aeval a (derivative (minpoly R a)) * x) =
      algebraMap B L (c * x) := by
    rw [← hwy, hF', smul_eq_mul]
    change _ * algebraMap B L c * _ = _
    rw [map_mul, map_mul, mul_mul_mul_comm, inv_mul_cancel₀ hne, one_mul]
  refine ⟨c, LinearMap.ext fun x ↦ ?_⟩
  rw [precompModule_smul_apply, precompModule_smul_apply]
  apply IsFractionRing.injective R K
  rw [← hφK, ← hy, key, trace_algebraMap_fractionRing]

omit [IsDomain B] in
/-- **Local monogenicity.** At a maximal ideal `q` with separable residue field extension, `B` is
locally generated by one element: there are `a ∈ B` and `s ∈ R[a] \ q` with `s B ⊆ R[a]`. -/
lemma exists_mem_adjoin_mul_mem_adjoin [IsDedekindDomain B] (q : Ideal B) [q.IsMaximal]
    (hq : q ≠ ⊥) [Algebra.IsSeparable (R ⧸ q.under R) (B ⧸ q)] :
    ∃ a s : B, s ∈ Algebra.adjoin R {a} ∧ s ∉ q ∧ ∀ b, s * b ∈ Algebra.adjoin R {a} := by
  classical
  set p := q.under R
  have hp0 : p ≠ ⊥ := fun h ↦ hq (Ideal.eq_bot_of_comap_eq_bot h)
  -- a primitive element of the residue field extension
  obtain ⟨α, hα⟩ := Field.exists_primitive_element (R ⧸ p) (B ⧸ q)
  set g := minpoly (R ⧸ p) α
  have hαint : IsIntegral (R ⧸ p) α := Algebra.IsIntegral.isIntegral α
  have hsep : g.Separable := Algebra.IsSeparable.isSeparable (R ⧸ p) α
  obtain ⟨gR, hgR⟩ :=
    Polynomial.map_surjective (Ideal.Quotient.mk p) Ideal.Quotient.mk_surjective g
  have hmk (b : B) (P : R[X]) : Ideal.Quotient.mk q (aeval b P) =
      aeval (Ideal.Quotient.mk q b) (P.map (Ideal.Quotient.mk p)) := by
    rw [← Ideal.Quotient.algebraMap_eq p, aeval_map_algebraMap, ← Ideal.Quotient.algebraMap_eq q,
      aeval_algebraMap_apply]
  have hg0 (b : B) (hb : Ideal.Quotient.mk q b = α) : aeval b gR ∈ q := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, hmk, hb, hgR, minpoly.aeval]
  obtain ⟨α₀, hα₀⟩ := Ideal.Quotient.mk_surjective α
  obtain ⟨π, hπq, hπq2⟩ := SetLike.exists_of_lt (Ideal.pow_succ_lt_pow hq 1)
  rw [pow_one] at hπq
  rw [show 1 + 1 = 2 from rfl] at hπq2
  have hrad : (q ^ 2).radical = q := by
    rw [Ideal.radical_pow _ two_ne_zero, Ideal.IsPrime.radical inferInstance]
  have hprim : (q ^ 2).IsPrimary := Ideal.isPrimary_of_isMaximal_radical (by rwa [hrad])
  -- a lift of `α` at which the lift of `g` is a uniformizer
  obtain ⟨a₁, ha₁α, ha₁q2⟩ : ∃ a₁ : B, Ideal.Quotient.mk q a₁ = α ∧ aeval a₁ gR ∉ q ^ 2 := by
    by_cases h : aeval α₀ gR ∈ q ^ 2
    · refine ⟨α₀ + π, by rw [map_add, hα₀, Ideal.Quotient.eq_zero_iff_mem.2 hπq, add_zero], ?_⟩
      obtain ⟨c, hc⟩ := Polynomial.binomExpansion (gR.map (algebraMap R B)) α₀ π
      rw [eval_map_algebraMap, eval_map_algebraMap, derivative_map, eval_map_algebraMap] at hc
      rw [hc]
      intro hmem
      have h2 : c * π ^ 2 ∈ q ^ 2 := Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow hπq 2)
      have h1 : π * aeval α₀ (derivative gR) ∈ q ^ 2 := by
        have := (q ^ 2).sub_mem ((q ^ 2).sub_mem hmem h) h2
        have e : aeval α₀ gR + aeval α₀ (derivative gR) * π + c * π ^ 2 - aeval α₀ gR -
            c * π ^ 2 = π * aeval α₀ (derivative gR) := by ring
        rwa [e] at this
      rcases (Ideal.isPrimary_iff.mp hprim).2 h1 with h3 | h3
      · exact hπq2 h3
      · rw [hrad] at h3
        apply hsep.aeval_derivative_ne_zero (minpoly.aeval (R ⧸ p) α)
        rw [← hgR, derivative_map, ← hα₀, ← hmk]
        exact Ideal.Quotient.eq_zero_iff_mem.2 h3
    · exact ⟨α₀, hα₀, h⟩
  -- a constant which is not a root of `g`
  obtain ⟨c, hc⟩ : ∃ c : R, g.eval (Ideal.Quotient.mk p c) ≠ 0 := by
    by_cases h0 : g.eval 0 = 0
    · refine ⟨1, ?_⟩
      have hdeg : g.degree = 1 :=
        Polynomial.degree_eq_one_of_irreducible_of_root (minpoly.irreducible hαint) h0
      have hm : g.Monic := minpoly.monic hαint
      have hX : g = X := by
        conv_lhs => rw [hm.eq_X_add_C (natDegree_eq_of_degree_eq_some hdeg)]
        rw [coeff_zero_eq_eval_zero, h0, map_zero, add_zero]
      rw [map_one, hX, eval_X]
      exact one_ne_zero
    · exact ⟨0, by rwa [map_zero]⟩
  -- the Chinese remainder theorem
  set S := IsDedekindDomain.primesOverFinset p B
  have hmemS (Q : Ideal B) : Q ∈ S ↔ Q ∈ p.primesOver B :=
    IsDedekindDomain.mem_primesOverFinset_iff hp0 B
  have hqS : q ∈ S := (hmemS q).2 ⟨inferInstance, ⟨rfl⟩⟩
  have hprime (Q : Ideal B) (hQ : Q ∈ S) : Prime Q := by
    obtain ⟨hQp, ⟨hQo⟩⟩ := (hmemS Q).1 hQ
    refine Ideal.prime_of_isPrime (fun h ↦ hp0 ?_) hQp
    rw [hQo, h]
    exact Ideal.comap_bot_of_injective _ (FaithfulSMul.algebraMap_injective R B)
  obtain ⟨a, ha⟩ := IsDedekindDomain.exists_forall_sub_mem_ideal (s := S) id
    (fun Q ↦ if Q = q then 2 else 1) hprime (fun _ _ _ _ h ↦ h)
    (fun Q ↦ if Q.1 = q then a₁ else algebraMap R B c)
  have haq2 : a - a₁ ∈ q ^ 2 := by simpa using ha q hqS
  have hsub (I : Ideal B) (x y : B) (hxy : x - y ∈ I) : aeval x gR - aeval y gR ∈ I := by
    obtain ⟨z, hz⟩ := Polynomial.sub_dvd_eval_sub x y (gR.map (algebraMap R B))
    rw [eval_map_algebraMap, eval_map_algebraMap] at hz
    rw [hz]
    exact I.mul_mem_right _ hxy
  have haα : Ideal.Quotient.mk q a = α := by
    rw [← ha₁α, Ideal.Quotient.eq]
    exact Ideal.pow_le_self two_ne_zero haq2
  have hga : aeval a gR ∈ q := hg0 a haα
  have hga2 : aeval a gR ∉ q ^ 2 := fun h ↦ ha₁q2 (by
    simpa using (q ^ 2).sub_mem h (hsub _ a a₁ haq2))
  have hgQ (Q : Ideal B) (hQ : Q ∈ S) (hQq : Q ≠ q) : aeval a gR ∉ Q := by
    intro h
    have h1 : a - algebraMap R B c ∈ Q := by simpa [hQq] using ha Q hQ
    have h2 := Q.sub_mem h (hsub Q _ _ h1)
    rw [sub_sub_cancel, aeval_algebraMap_apply_eq_algebraMap_eval] at h2
    obtain ⟨-, ⟨hQo⟩⟩ := (hmemS Q).1 hQ
    have h3 : gR.eval c ∈ p := by rw [hQo]; exact h2
    apply hc
    rw [← hgR, eval_map, eval₂_hom]
    exact Ideal.Quotient.eq_zero_iff_mem.2 h3
  -- `q` is generated by `p` and `g(a)`
  have hJ : q ≤ p.map (algebraMap R B) ⊔ Ideal.span {aeval a gR} := by
    set J := p.map (algebraMap R B) ⊔ Ideal.span {aeval a gR}
    have hJq : J ≤ q := sup_le (Ideal.map_le_iff_le_comap.2 le_rfl)
      ((Ideal.span_singleton_le_iff_mem _).2 hga)
    obtain ⟨J', hJ'⟩ := Ideal.dvd_iff_le.2 hJq
    suffices J' = ⊤ by rw [hJ', this, Ideal.mul_top]
    by_contra hJ'top
    obtain ⟨M, hM, hJ'M⟩ := Ideal.exists_le_maximal J' hJ'top
    have hgJ : aeval a gR ∈ J := Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)
    by_cases hMq : M = q
    · rw [hMq] at hJ'M
      apply hga2
      rw [pow_two]
      exact Ideal.mul_mono_right hJ'M (hJ' ▸ hgJ)
    · have hJM : J ≤ M := hJ'.le.trans (Ideal.mul_le_right.trans hJ'M)
      have hpM : p ≤ M.under R := Ideal.map_le_iff_le_comap.1 (le_sup_left.trans hJM)
      have hMo : M.under R = p := (Ideal.IsMaximal.eq_of_le inferInstance
        (Ideal.IsPrime.ne_top inferInstance) hpM).symm
      exact hgQ M ((hmemS M).2 ⟨inferInstance, ⟨hMo.symm⟩⟩) hMq (hJM hgJ)
  -- Nakayama
  set C := Algebra.adjoin R {a}
  set q' : Ideal C := q.comap (algebraMap C B)
  have hgaC : aeval a gR ∈ C := Polynomial.aeval_mem_adjoin_singleton R a
  have hqmap : q ≤ q'.map (algebraMap C B) := by
    refine hJ.trans (sup_le ?_ ?_)
    · rw [Ideal.map_le_iff_le_comap]
      intro r hr
      rw [Ideal.mem_comap, IsScalarTower.algebraMap_apply R C B]
      refine Ideal.mem_map_of_mem _ ?_
      rw [Ideal.mem_comap, ← IsScalarTower.algebraMap_apply]
      exact hr
    · rw [Ideal.span_singleton_le_iff_mem]
      exact Ideal.mem_map_of_mem (algebraMap C B) (show (⟨_, hgaC⟩ : C) ∈ q' from hga)
  have hBC (b : B) : ∃ c' ∈ C, b - c' ∈ q := by
    have hadj : Algebra.adjoin (R ⧸ p) {α} = ⊤ := by
      rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hαint.isAlgebraic, hα,
        IntermediateField.top_toSubalgebra]
    have hb : Ideal.Quotient.mk q b ∈ Algebra.adjoin (R ⧸ p) {α} := hadj ▸ Algebra.mem_top
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hb
    obtain ⟨h, hh⟩ := hb
    obtain ⟨hR, rfl⟩ :=
      Polynomial.map_surjective (Ideal.Quotient.mk p) Ideal.Quotient.mk_surjective h
    refine ⟨aeval a hR, Polynomial.aeval_mem_adjoin_singleton R a, ?_⟩
    rw [← Ideal.Quotient.eq, hmk, haα]
    exact hh.symm
  let N : Submodule C B := LinearMap.range (Algebra.linearMap C B)
  have hfin : Module.Finite C B := Module.Finite.of_restrictScalars_finite R C B
  obtain ⟨r, hr1, hr⟩ := Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul q'
    (⊤ : Submodule C (B ⧸ N)) (Module.Finite.fg_top) (by
      rintro m -
      obtain ⟨b, rfl⟩ := N.mkQ_surjective m
      obtain ⟨c', hc', hbc⟩ := hBC b
      have h1 : b - c' ∈ q' • (⊤ : Submodule C B) := by
        rw [Ideal.smul_top_eq_map]
        exact hqmap hbc
      have h2 : N.mkQ b = N.mkQ (b - c') := by
        rw [map_sub, Submodule.mkQ_apply N c',
          (Submodule.Quotient.mk_eq_zero N (x := c')).2 ⟨⟨c', hc'⟩, rfl⟩,
          sub_zero]
      rw [h2]
      have := Submodule.mem_map_of_mem (f := N.mkQ) h1
      rw [Submodule.map_smul'', Submodule.map_top, Submodule.range_mkQ] at this
      exact this)
  refine ⟨a, r, r.2, fun hrq ↦ ?_, fun b ↦ ?_⟩
  · have : (r : B) - 1 ∈ q := hr1
    exact (Ideal.IsPrime.ne_top inferInstance) ((Ideal.eq_top_iff_one q).2 (by
      simpa using q.sub_mem hrq this))
  · have := hr (N.mkQ b) Submodule.mem_top
    rw [← LinearMap.map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at this
    obtain ⟨c', hc'⟩ := this
    have e : (r : B) * b = algebraMap C B c' := by
      rw [← Algebra.linearMap_apply C B, hc', Algebra.smul_def]; rfl
    rw [e]
    exact c'.2

section Jacobian

open TrivSqZeroExt

variable (q : Ideal B) [q.IsMaximal]

/-- The ring map `R → κ(q)[ε]`, `r ↦ r + c D(r) ε`. -/
noncomputable def twistHom (c : B ⧸ q) : R →+* TrivSqZeroExt (B ⧸ q) (B ⧸ q) where
  toFun r := (Ideal.Quotient.mk q (algebraMap R B r),
    c * Ideal.Quotient.mk q (algebraMap R B (D r)))
  map_one' := by ext <;> simp
  map_mul' r r' := by
    apply TrivSqZeroExt.ext
    · change Ideal.Quotient.mk q (algebraMap R B (r * r')) =
        Ideal.Quotient.mk q (algebraMap R B r) * Ideal.Quotient.mk q (algebraMap R B r')
      simp only [map_mul]
    · change c * Ideal.Quotient.mk q (algebraMap R B (D (r * r'))) =
        Ideal.Quotient.mk q (algebraMap R B r) *
            (c * Ideal.Quotient.mk q (algebraMap R B (D r'))) +
          (c * Ideal.Quotient.mk q (algebraMap R B (D r))) *
            Ideal.Quotient.mk q (algebraMap R B r')
      simp only [D.leibniz, smul_eq_mul, map_add, map_mul]
      ring
  map_zero' := by apply TrivSqZeroExt.ext <;> simp
  map_add' r r' := by
    apply TrivSqZeroExt.ext
    · change Ideal.Quotient.mk q (algebraMap R B (r + r')) =
        Ideal.Quotient.mk q (algebraMap R B r) + Ideal.Quotient.mk q (algebraMap R B r')
      simp only [map_add]
    · change c * Ideal.Quotient.mk q (algebraMap R B (D (r + r'))) =
        c * Ideal.Quotient.mk q (algebraMap R B (D r)) +
          c * Ideal.Quotient.mk q (algebraMap R B (D r'))
      simp only [map_add, mul_add]

omit [IsDomain R] [IsDomain B] [Algebra k B] [IsScalarTower k R B] [Module.Free R B]
  [Module.Finite R B] [q.IsMaximal] in
@[simp] lemma fst_twistHom (c : B ⧸ q) (r : R) :
    (twistHom D q c r).fst = Ideal.Quotient.mk q (algebraMap R B r) := rfl

omit [IsDomain R] [IsDomain B] [Algebra k B] [IsScalarTower k R B] [Module.Free R B]
  [Module.Finite R B] [q.IsMaximal] in
@[simp] lemma snd_twistHom (c : B ⧸ q) (r : R) :
    (twistHom D q c r).snd = c * Ideal.Quotient.mk q (algebraMap R B (D r)) := rfl

omit [IsDomain R] [IsDomain B] [Algebra k B] [IsScalarTower k R B] [Module.Free R B]
  [Module.Finite R B] [q.IsMaximal] in
/-- Evaluation of a polynomial at `a + c₂ ε` along `twistHom`. -/
lemma eval₂_twistHom (c c₂ : B ⧸ q) (a : B) (P : R[X]) :
    P.eval₂ (twistHom D q c)
        ((Ideal.Quotient.mk q a, c₂) : TrivSqZeroExt (B ⧸ q) (B ⧸ q)) =
      ((Ideal.Quotient.mk q (aeval a P), c * Ideal.Quotient.mk q (aeval a (derivCoeff D P)) +
        c₂ * Ideal.Quotient.mk q (aeval a (derivative P))) :
        TrivSqZeroExt (B ⧸ q) (B ⧸ q)) := by
  induction P using Polynomial.induction_on' with
  | add p p' hp hp' =>
    rw [eval₂_add (S := TrivSqZeroExt (B ⧸ q) (B ⧸ q)), hp, hp',
      derivCoeff_add, derivative_add]
    apply TrivSqZeroExt.ext <;> simp only [fst_add, snd_add, map_add, fst_mk, snd_mk]
    ring
  | monomial n r =>
    rw [eval₂_monomial (S := TrivSqZeroExt (B ⧸ q) (B ⧸ q)),
      derivCoeff_monomial, derivative_monomial]
    apply TrivSqZeroExt.ext
    · simp [aeval_monomial]
    · simp only [snd_mul, fst_twistHom, snd_twistHom, snd_pow, fst_pow, smul_eq_mul,
        op_smul_eq_mul, aeval_monomial, map_mul, map_pow, nsmul_eq_mul, map_natCast,
        Nat.pred_eq_sub_one, fst_mk, snd_mk]
      ring

variable {q}

/-- The ring map `R[a] → κ(q)[ε]` extending `twistHom` by `a ↦ a + c₂ ε`; it exists if
`c F^D(a) + c₂ F'(a) ∈ q` for the minimal polynomial `F` of `a`. -/
noncomputable def adjoinHom [IsIntegrallyClosed R] (a : B) (c c₂ : B ⧸ q)
    (h : c * Ideal.Quotient.mk q (aeval a (derivCoeff D (minpoly R a))) +
      c₂ * Ideal.Quotient.mk q (aeval a (derivative (minpoly R a))) = 0) :
    Algebra.adjoin R {a} →+* TrivSqZeroExt (B ⧸ q) (B ⧸ q) :=
  (AdjoinRoot.lift (twistHom D q c)
    ((Ideal.Quotient.mk q a, c₂) : TrivSqZeroExt (B ⧸ q) (B ⧸ q)) (by
    rw [eval₂_twistHom, minpoly.aeval, map_zero, h]; rfl)).comp
    ((minpoly.equivAdjoin (Algebra.IsIntegral.isIntegral (R := R) a)).symm :
      Algebra.adjoin R {a} →+* AdjoinRoot (minpoly R a))

lemma coe_equivAdjoin_mk [IsIntegrallyClosed R] (a : B) (P : R[X]) :
    ((minpoly.equivAdjoin (Algebra.IsIntegral.isIntegral (R := R) a))
      (AdjoinRoot.mk (minpoly R a) P) : B) = aeval a P := by
  simp only [minpoly.coe_equivAdjoin]
  simp only [AdjoinRoot.Minpoly.coe_toAdjoin, AdjoinRoot.liftAlgHom_mk, toRingHom_ofId]
  rw [← aeval_def, aeval_subalgebra_coe]

omit [Algebra k B] [IsScalarTower k R B] [q.IsMaximal] in
lemma fst_adjoinHom [IsIntegrallyClosed R] (a : B) (c c₂ : B ⧸ q) (h) (x : Algebra.adjoin R {a}) :
    (adjoinHom D a c c₂ h x).fst = Ideal.Quotient.mk q (x : B) := by
  obtain ⟨z, rfl⟩ := (minpoly.equivAdjoin (Algebra.IsIntegral.isIntegral (R := R) a)).surjective x
  induction z using AdjoinRoot.induction_on with
  | ih P =>
    simp only [adjoinHom, RingHom.coe_comp, Function.comp_apply, RingHom.coe_coe,
      AlgEquiv.symm_apply_apply,
      AdjoinRoot.lift_mk (S := TrivSqZeroExt (B ⧸ q) (B ⧸ q)), eval₂_twistHom, fst_mk]
    rw [coe_equivAdjoin_mk]

omit [Algebra k B] [IsScalarTower k R B] [q.IsMaximal] in
lemma adjoinHom_self [IsIntegrallyClosed R] (a : B) (c c₂ : B ⧸ q) (h) :
    adjoinHom D a c c₂ h ⟨a, Algebra.self_mem_adjoin_singleton R a⟩ =
      ((Ideal.Quotient.mk q a, c₂) : TrivSqZeroExt (B ⧸ q) (B ⧸ q)) := by
  have : (minpoly.equivAdjoin (Algebra.IsIntegral.isIntegral (R := R) a)).symm
      ⟨a, Algebra.self_mem_adjoin_singleton R a⟩ = AdjoinRoot.root (minpoly R a) := by
    rw [AlgEquiv.symm_apply_eq]
    exact Subtype.ext (by rw [AdjoinRoot.root, coe_equivAdjoin_mk, aeval_X])
  simp only [adjoinHom, RingHom.coe_comp, Function.comp_apply, RingHom.coe_coe, this,
    AdjoinRoot.lift_root (S := TrivSqZeroExt (B ⧸ q) (B ⧸ q))]

omit [Algebra k B] [IsScalarTower k R B] [q.IsMaximal] in
lemma adjoinHom_algebraMap [IsIntegrallyClosed R] (a : B) (c c₂ : B ⧸ q) (h) (r : R) :
    adjoinHom D a c c₂ h (algebraMap R _ r) = twistHom D q c r := by
  simp only [adjoinHom, RingHom.coe_comp, Function.comp_apply, RingHom.coe_coe,
    AlgEquiv.commutes, AdjoinRoot.algebraMap_eq,
    AdjoinRoot.lift_of (S := TrivSqZeroExt (B ⧸ q) (B ⧸ q))]

/-- A ring map on `R[a]` extends to `B` if `s B ⊆ R[a]` and the image of `s` is a unit. -/
noncomputable def extendHom {T : Type*} [CommRing T] {a s : B}
    (ρ : Algebra.adjoin R {a} →+* T) (hs : s ∈ Algebra.adjoin R {a})
    (hsB : ∀ b, s * b ∈ Algebra.adjoin R {a}) (hu : IsUnit (ρ ⟨s, hs⟩)) : B →+* T where
  toFun b := ρ ⟨s * b, hsB b⟩ * ↑hu.unit⁻¹
  map_one' := by
    simp only [mul_one]
    exact hu.mul_val_inv
  map_mul' b b' := by
    have e : (⟨s * b, hsB b⟩ : Algebra.adjoin R {a}) * ⟨s * b', hsB b'⟩ =
        ⟨s, hs⟩ * ⟨s * (b * b'), hsB _⟩ := Subtype.ext (by simp only [MulMemClass.mk_mul_mk]; ring)
    have e' := congrArg ρ e
    rw [map_mul, map_mul] at e'
    calc ρ ⟨s * (b * b'), hsB _⟩ * ↑hu.unit⁻¹
        = ρ ⟨s, hs⟩ * ρ ⟨s * (b * b'), hsB _⟩ * ↑hu.unit⁻¹ * ↑hu.unit⁻¹ := by
          rw [mul_comm (ρ ⟨s, hs⟩), mul_assoc _ (ρ ⟨s, hs⟩), hu.mul_val_inv, mul_one]
      _ = _ := by rw [← e']; ring
  map_zero' := by
    change ρ ⟨s * 0, hsB 0⟩ * _ = 0
    rw [show (⟨s * 0, hsB 0⟩ : Algebra.adjoin R {a}) = 0 from Subtype.ext (mul_zero s), map_zero,
      zero_mul]
  map_add' b b' := by
    simp only [mul_add]
    rw [← add_mul, ← map_add]
    rfl

omit [IsDomain R] [IsDomain B] [Module.Free R B] [Module.Finite R B] in
lemma extendHom_of_mem {T : Type*} [CommRing T] {a s : B}
    (ρ : Algebra.adjoin R {a} →+* T) (hs : s ∈ Algebra.adjoin R {a})
    (hsB : ∀ b, s * b ∈ Algebra.adjoin R {a}) (hu : IsUnit (ρ ⟨s, hs⟩)) (x : Algebra.adjoin R {a}) :
    extendHom ρ hs hsB hu x = ρ x := by
  change ρ ⟨s * x, hsB x⟩ * ↑hu.unit⁻¹ = ρ x
  have : (⟨s * x, hsB x⟩ : Algebra.adjoin R {a}) = ⟨s, hs⟩ * x := rfl
  rw [this, map_mul, mul_comm (ρ ⟨s, hs⟩), mul_assoc, hu.mul_val_inv, mul_one]

/-- The derivation `B → κ(q)` given by the `ε`-component of a ring map `B → κ(q)[ε]` lifting the
residue map. -/
noncomputable def derivationOfHom (ρ : B →+* TrivSqZeroExt (B ⧸ q) (B ⧸ q))
    (hfst : ∀ b, (ρ b).fst = Ideal.Quotient.mk q b)
    (hk : ∀ x : k, (ρ (algebraMap k B x)).snd = 0) : Derivation k B (B ⧸ q) :=
  Derivation.mk' (R := k) (A := B) (M := B ⧸ q)
    { toFun b := (ρ b).snd
      map_add' b b' := by rw [map_add, snd_add]
      map_smul' x b := by
        rw [Algebra.smul_def, map_mul, snd_mul, hk, hfst, smul_eq_mul, op_smul_eq_mul, zero_mul,
          add_zero, RingHom.id_apply, Algebra.smul_def, Ideal.Quotient.mk_algebraMap] }
    fun b b' ↦ by
      simp only [LinearMap.coe_mk, AddHom.coe_mk, map_mul, snd_mul, hfst, smul_eq_mul,
        op_smul_eq_mul, Algebra.smul_def, Ideal.Quotient.algebraMap_eq]
      ring

omit [IsDomain B] [q.IsMaximal] in
@[simp] lemma derivationOfHom_apply (ρ : B →+* TrivSqZeroExt (B ⧸ q) (B ⧸ q)) (hfst hk) (b : B) :
    derivationOfHom (k := k) ρ hfst hk b = (ρ b).snd := rfl


end Jacobian

/-- **Jacobian criterion.** If `B` is locally monogenic at `q`, `s B ⊆ R[a]` with `s ∉ q`, and
`Ω_{B/k}` is generated by one element near `q`, then `F'(a) ∉ q` or `F^D(a) ∉ q` for the minimal
polynomial `F` of `a` over `R`. -/
lemma derivative_or_derivCoeff_not_mem [IsIntegrallyClosed R] (t : R) (ht : D t = 1)
    (q : Ideal B) [q.IsMaximal] {a s : B} (hs : s ∈ Algebra.adjoin R {a}) (hsq : s ∉ q)
    (hsB : ∀ b, s * b ∈ Algebra.adjoin R {a}) (ω₀ : Ω[B⁄k]) (s' : B) (hs' : s' ∉ q)
    (hω₀ : ∀ ω : Ω[B⁄k], ∃ b : B, s' • ω = b • ω₀) :
    aeval a (derivative (minpoly R a)) ∉ q ∨ aeval a (derivCoeff D (minpoly R a)) ∉ q := by
  by_contra hcon
  rw [not_or, not_not, not_not] at hcon
  obtain ⟨h1, h2⟩ := hcon
  have hz (c c₂ : B ⧸ q) : c * Ideal.Quotient.mk q (aeval a (derivCoeff D (minpoly R a))) +
      c₂ * Ideal.Quotient.mk q (aeval a (derivative (minpoly R a))) = 0 := by
    rw [Ideal.Quotient.eq_zero_iff_mem.2 h2, Ideal.Quotient.eq_zero_iff_mem.2 h1]; ring
  have hsq' : Ideal.Quotient.mk q s ≠ 0 := by rwa [ne_eq, Ideal.Quotient.eq_zero_iff_mem]
  have hder (c c₂ : B ⧸ q) :
      ∃ δ : Derivation k B (B ⧸ q), δ (algebraMap R B t) = c ∧ δ a = c₂ := by
    let ρC := adjoinHom D a c c₂ (hz c c₂)
    have hu : IsUnit (ρC ⟨s, hs⟩) := by
      rw [TrivSqZeroExt.isUnit_iff_isUnit_fst, fst_adjoinHom]
      exact isUnit_iff_ne_zero.2 hsq'
    let ρ := extendHom ρC hs hsB hu
    have hρ (x : Algebra.adjoin R {a}) : ρ x = ρC x := extendHom_of_mem ρC hs hsB hu x
    have hfst (b : B) : (ρ b).fst = Ideal.Quotient.mk q b := by
      have e : (ρ s).fst * (ρ b).fst = (ρ (s * b)).fst := by
        rw [map_mul, TrivSqZeroExt.fst_mul]
      rw [show s = ((⟨s, hs⟩ : Algebra.adjoin R {a}) : B) from rfl, hρ,
        show s * b = ((⟨s * b, hsB b⟩ : Algebra.adjoin R {a}) : B) from rfl, hρ,
        fst_adjoinHom, fst_adjoinHom, map_mul] at e
      exact mul_left_cancel₀ hsq' e
    have hRa (r : R) : ρ (algebraMap R B r) = twistHom D q c r := by
      rw [show algebraMap R B r = ((algebraMap R (Algebra.adjoin R {a}) r : _) : B) from rfl,
        hρ, adjoinHom_algebraMap]
    have hk (x : k) : (ρ (algebraMap k B x)).snd = 0 := by
      rw [IsScalarTower.algebraMap_apply k R B, hRa, snd_twistHom, D.map_algebraMap, map_zero,
        map_zero, mul_zero]
    refine ⟨derivationOfHom ρ hfst hk, ?_, ?_⟩
    · rw [derivationOfHom_apply, hRa, snd_twistHom, ht, map_one, map_one, mul_one]
    · rw [derivationOfHom_apply,
        show a = ((⟨a, Algebra.self_mem_adjoin_singleton R a⟩ : Algebra.adjoin R {a}) : B) from rfl,
        hρ, adjoinHom_self]
      rfl
  obtain ⟨δ₁, h₁t, h₁a⟩ := hder 1 0
  obtain ⟨δ₂, h₂t, h₂a⟩ := hder 0 1
  obtain ⟨β₁, hβ₁⟩ := hω₀ (KaehlerDifferential.D k B (algebraMap R B t))
  obtain ⟨β₂, hβ₂⟩ := hω₀ (KaehlerDifferential.D k B a)
  have hsmul (b : B) (x : B ⧸ q) : b • x = Ideal.Quotient.mk q b * x := by
    rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq]
  have ev (δ : Derivation k B (B ⧸ q)) (b : B) {ω : Ω[B⁄k]} (x : B ⧸ q)
      (hb : s' • ω = b • ω₀) (hx : δ.liftKaehlerDifferential ω = x) :
      Ideal.Quotient.mk q s' * x = Ideal.Quotient.mk q b * δ.liftKaehlerDifferential ω₀ := by
    have := congrArg δ.liftKaehlerDifferential hb
    rwa [LinearMap.map_smul, LinearMap.map_smul, hx, hsmul, hsmul] at this
  have e11 := ev δ₁ β₁ _ hβ₁ (by rw [Derivation.liftKaehlerDifferential_comp_D, h₁t])
  have e12 := ev δ₁ β₂ _ hβ₂ (by rw [Derivation.liftKaehlerDifferential_comp_D, h₁a])
  have e22 := ev δ₂ β₂ _ hβ₂ (by rw [Derivation.liftKaehlerDifferential_comp_D, h₂a])
  have hs'q : Ideal.Quotient.mk q s' ≠ 0 := by rwa [ne_eq, Ideal.Quotient.eq_zero_iff_mem]
  rw [mul_one] at e11 e22
  rw [mul_zero] at e12
  have hℓ : δ₁.liftKaehlerDifferential ω₀ ≠ 0 := fun h ↦ hs'q (by rw [e11, h, mul_zero])
  have hβ₂0 : Ideal.Quotient.mk q β₂ = 0 := (mul_eq_zero.mp e12.symm).resolve_right hℓ
  exact hs'q (by rw [e22, hβ₂0, zero_mul])

/-- **Duality for the trace of differentials.** The trace derivation induces an isomorphism
`Ω_{B/k} ≅ Hom_R(B, R)`. -/
theorem bijective_liftKaehlerDifferential_traceDerivation [IsIntegrallyClosed R]
    [IsNoetherianRing B] [Ring.DimensionLEOne B] [IsIntegrallyClosed B]
    [Algebra.IsSeparable (FractionRing R) (FractionRing B)]
    (hR : ¬ IsField R) (t : R) (ht : D t = 1)
    (hres : ∀ q : Ideal B, q.IsMaximal → Algebra.IsSeparable (R ⧸ q.under R) (B ⧸ q))
    (hsm : ∀ q : Ideal B, q.IsMaximal →
      ∃ ω₀ : Ω[B⁄k], ∃ s ∉ q, ∀ ω : Ω[B⁄k], ∃ b : B, s • ω = b • ω₀) :
    Function.Bijective (traceDerivation (B := B) D).liftKaehlerDifferential := by
  have : IsDedekindDomain B := {}
  set Ψ := (traceDerivation (B := B) D).liftKaehlerDifferential
  have hΨt : Ψ (KaehlerDifferential.D k B (algebraMap R B t)) = Algebra.trace R B := by
    rw [Derivation.liftKaehlerDifferential_comp_D, traceDerivation_algebraMap, ht, map_one,
      one_smul]
  have hB : ¬ IsField B := fun h ↦ hR <|
    (Algebra.IsIntegral.isField_iff_isField (FaithfulSMul.algebraMap_injective R B)).2 h
  have hq₀ (q : Ideal B) [hq : q.IsMaximal] : q ≠ ⊥ :=
    Ring.ne_bot_of_isMaximal_of_not_isField hq hB
  refine ⟨fun ω ω' h ↦ ?_, fun φ ↦ ?_⟩
  · rw [← sub_eq_zero]
    set η := ω - ω'
    have hη : Ψ η = 0 := by rw [map_sub, h, sub_self]
    let I : Ideal B := Submodule.comap (LinearMap.toSpanSingleton B _ η) ⊥
    suffices I = ⊤ by
      have h1 : (1 : B) ∈ I := this ▸ Submodule.mem_top
      simpa [I] using h1
    by_contra hI
    obtain ⟨q, hq, hIq⟩ := Ideal.exists_le_maximal I hI
    obtain ⟨ω₀, s', hs', hω₀⟩ := hsm q hq
    obtain ⟨b, hb⟩ := hω₀ η
    by_cases hb0 : b = 0
    · exact hs' (hIq (by simp [I, hb, hb0]))
    have hΨ₀ : Ψ ω₀ = 0 := eq_zero_of_smul_eq_zero hb0 (by
      rw [← LinearMap.map_smul, ← hb, LinearMap.map_smul, hη, smul_zero])
    obtain ⟨b', hb'⟩ := hω₀ (KaehlerDifferential.D k B (algebraMap R B t))
    have hs'0 : s' ≠ 0 := fun h ↦ hs' (h ▸ q.zero_mem)
    refine trace_ne_zero (R := R) (B := B) (eq_zero_of_smul_eq_zero hs'0 ?_)
    rw [← hΨt, ← LinearMap.map_smul, hb', LinearMap.map_smul, hΨ₀, smul_zero]
  · let I : Ideal B := Submodule.comap (LinearMap.toSpanSingleton B _ φ) (LinearMap.range Ψ)
    suffices I = ⊤ by
      have h1 : (1 : B) ∈ I := this ▸ Submodule.mem_top
      simpa [I] using h1
    by_contra hI
    obtain ⟨q, hq, hIq⟩ := Ideal.exists_le_maximal I hI
    have := hres q hq
    obtain ⟨a, s, hs, hsq, hsB⟩ := exists_mem_adjoin_mul_mem_adjoin (R := R) q (hq₀ q)
    obtain ⟨ω₀, s', hs', hω₀⟩ := hsm q hq
    have hs0 : s ≠ 0 := fun h ↦ hsq (h ▸ q.zero_mem)
    obtain ⟨c, hc⟩ := exists_smul_eq_smul_trace hs0 hs hsB φ
    have hmem (x : B) (y : Ω[B⁄k]) (hxy : x • φ = Ψ y) : x ∈ I := by
      change x • φ ∈ LinearMap.range Ψ
      exact ⟨y, hxy.symm⟩
    rcases derivative_or_derivCoeff_not_mem D t ht q hs hsq hsB ω₀ s' hs' hω₀ with h | h
    · refine h (hIq (hmem _ (c • KaehlerDifferential.D k B (algebraMap R B t)) ?_))
      rw [hc, LinearMap.map_smul, hΨt]
    · refine h (hIq (hmem _ (-(c • KaehlerDifferential.D k B a)) ?_))
      have hF := smul_traceDerivation_eq D (minpoly.aeval R a)
      have e1 : Ψ (-(c • KaehlerDifferential.D k B a)) = -(c • traceDerivation D a) := by
        rw [map_neg, LinearMap.map_smul, Derivation.liftKaehlerDifferential_comp_D]
      rw [← sub_eq_zero]
      apply eq_zero_of_smul_eq_zero (aeval_derivative_minpoly_ne_zero (R := R) a)
      rw [e1, sub_neg_eq_add, smul_add, smul_comm _ _ φ, hc, smul_comm _ c (traceDerivation D a),
        hF, smul_comm _ c, smul_neg, add_neg_cancel]


end KaehlerDifferential
