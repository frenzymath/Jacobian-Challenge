import Jacobian.RingTheory.Kaehler.TraceDualityField

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

/-!
# Functoriality of the trace of differentials

Let `B` be finite free over `R`, `D : R → M` a `k`-derivation, and `R → R'`, `B → B'`,
`M → M'` compatible maps such that a basis of `B` over `R` maps to a basis of `B'` over `R'`
(e.g. `R' = R_h` and `B' = B_h`). Then the trace derivations of `B` and `B'` are compatible
(`Algebra.traceDeriv_map`).

We also reformulate duality for the trace of differentials
(`KaehlerDifferential.bijective_liftKaehlerDifferential_traceDerivation_of_smooth`) for
derivations `D : R → M` into a free module of rank one, such as `d : R → Ω_{R/k}`
(`KaehlerDifferential.bijective_liftKaehlerDifferential_traceDerivation_of_isFreeGenerator`).
-/


open Polynomial Algebra

namespace Algebra

variable {k R B M R' B' M' : Type*} [CommRing k] [CommRing R] [CommRing B] [Algebra k R]
  [Algebra R B] [AddCommGroup M] [Module R M] [Module k M] (D : Derivation k R M)
  [CommRing R'] [CommRing B'] [Algebra k R'] [Algebra R' B'] [AddCommGroup M'] [Module R' M']
  [Module k M'] (D' : Derivation k R' M')

/-- The matrix of multiplication by `ψ x` in the image of a basis is the image of the matrix of
multiplication by `x`. -/
lemma leftMulMatrix_map {ι : Type*} [Fintype ι] [DecidableEq ι] (b : Module.Basis ι R B)
    (b' : Module.Basis ι R' B') (σ : R →+* R') (ψ : B →+* B')
    (hψ : ∀ r, ψ (algebraMap R B r) = algebraMap R' B' (σ r)) (hb : ∀ i, b' i = ψ (b i))
    (x : B) : leftMulMatrix b' (ψ x) = (leftMulMatrix b x).map σ := by
  have hrepr (y : B) : b'.repr (ψ y) = Finsupp.mapRange σ σ.map_zero (b.repr y) := by
    conv_lhs => rw [← b.sum_repr y]
    rw [map_sum]
    simp_rw [Algebra.smul_def, map_mul, hψ, ← hb, ← Algebra.smul_def]
    ext i
    rw [b'.repr_sum_self, Finsupp.mapRange_apply]
  ext i j
  rw [Matrix.map_apply, leftMulMatrix_eq_repr_mul, leftMulMatrix_eq_repr_mul, hb, ← map_mul,
    hrepr, Finsupp.mapRange_apply]

variable [Module.Free R B] [Module.Finite R B] [Module.Free R' B'] [Module.Finite R' B']

/-- **Functoriality of the trace derivation.** Let `σ : R → R'`, `ψ : B → B'` and `μ : M → M'`
be compatible maps such that `ψ` maps a basis of `B` over `R` to a basis of `B'` over `R'`, and
`D' ∘ σ = μ ∘ D`. Then `traceDeriv D' (ψ a) (ψ c) = μ (traceDeriv D a c)`. -/
lemma traceDeriv_map {ι : Type*} [Finite ι] (b : Module.Basis ι R B)
    (b' : Module.Basis ι R' B') (σ : R →+* R') (ψ : B →+* B')
    (hψ : ∀ r, ψ (algebraMap R B r) = algebraMap R' B' (σ r)) (hb : ∀ i, b' i = ψ (b i))
    (μ : M →+ M') (hμ : ∀ (r : R) (m : M), μ (r • m) = σ r • μ m)
    (hD : ∀ r, D' (σ r) = μ (D r)) (a c : B) :
    traceDeriv D' (ψ a) (ψ c) = μ (traceDeriv D a c) := by
  classical
  have := Fintype.ofFinite ι
  rw [traceDeriv_eq D' b', traceDeriv_eq D b, traceDerivAux, traceDerivAux,
    leftMulMatrix_map b b' σ ψ hψ hb, leftMulMatrix_map b b' σ ψ hψ hb]
  simp only [Matrix.traceDerivForm, Matrix.map_apply, map_sum, hμ, hD]

end Algebra

namespace Algebra

variable {k R B M M' : Type*} [CommRing k] [CommRing R] [CommRing B] [Algebra k R]
  [Algebra R B] [AddCommGroup M] [Module R M] [Module k M] (D : Derivation k R M)
  [AddCommGroup M'] [Module R M'] [Module k M'] [Module.Free R B] [Module.Finite R B]

/-- The trace derivation is compatible with composition of `D` with a linear map. -/
lemma traceDeriv_compDer [IsScalarTower k R M] [IsScalarTower k R M'] (μ : M →ₗ[R] M')
    (a c : B) : traceDeriv (μ.compDer D) a c = μ (traceDeriv D a c) :=
  traceDeriv_map D (μ.compDer D) (Module.Free.chooseBasis R B) (Module.Free.chooseBasis R B)
    (RingHom.id R) (RingHom.id B) (fun _ ↦ rfl) (fun _ ↦ rfl) μ.toAddMonoidHom
    (fun r m ↦ μ.map_smul r m) (fun _ ↦ rfl) a c

end Algebra

namespace KaehlerDifferential

attribute [local instance] precompModule precompModule_isScalarTower

/-- **Duality for the trace of differentials, with values in a free module of rank one.** Let
`R = k[t]_g`, `M` an `R`-module freely generated by `e` and `D : R → M` a `k`-derivation with
`D t = e` (e.g. `d : R → Ω_{R/k}`). Under the hypotheses of
`bijective_liftKaehlerDifferential_traceDerivation_of_smooth`, the trace derivation induces an
isomorphism `Ω_{B/k} ≅ Hom_R(B, M)`. -/
theorem bijective_liftKaehlerDifferential_traceDerivation_of_isFreeGenerator {k R B M : Type*}
    [Field k] [CommRing R] [Algebra k R] [Algebra k[X] R] [IsScalarTower k k[X] R] (g : k[X])
    (hg : g ≠ 0) [IsLocalization.Away g R] [CommRing B] [Algebra R B] [Algebra k B]
    [IsScalarTower k R B] [Module.Free R B] [Module.Finite R B] [Algebra.Smooth k B]
    [AddCommGroup M] [Module R M] [Module k M] [IsScalarTower k R M] (e : M)
    (he : Function.Bijective fun r : R ↦ r • e)
    (D : Derivation k R M) (hD : D (algebraMap k[X] R X) = e)
    (hsm : ∀ q : Ideal B, q.IsMaximal →
      ∃ ω₀ : Ω[B⁄k], ∃ s ∉ q, ∀ ω : Ω[B⁄k], ∃ b : B, s • ω = b • ω₀)
    (hgen : ∀ (p : Ideal B) [p.IsPrime], p ∈ minimalPrimes B →
      Algebra.FormallyUnramified R (Localization.AtPrime p)) :
    Function.Bijective (traceDerivation (B := B) D).liftKaehlerDifferential := by
  let L : R ≃ₗ[R] M := LinearEquiv.ofBijective (LinearMap.toSpanSingleton R M e) he
  let D₀ : Derivation k R R := L.symm.toLinearMap.compDer D
  have hD₀ : D₀ (algebraMap k[X] R X) = 1 := by
    change L.symm (D _) = 1
    rw [hD, LinearEquiv.symm_apply_eq]
    exact (one_smul R e).symm
  have hbij := bijective_liftKaehlerDifferential_traceDerivation_of_smooth g hg D₀ hD₀ hsm hgen
  let Φ : (B →ₗ[R] R) →ₗ[B] (B →ₗ[R] M) :=
    { toFun φ := L.toLinearMap ∘ₗ φ
      map_add' _ _ := LinearMap.comp_add _ _ _
      map_smul' _ _ := rfl }
  have hΦ : Function.Bijective Φ :=
    (LinearEquiv.arrowCongr (LinearEquiv.refl R B) L).bijective
  have hDL : D = L.toLinearMap.compDer D₀ := by
    ext r
    change D r = L (L.symm (D r))
    rw [LinearEquiv.apply_symm_apply]
  have heq : (traceDerivation (B := B) D).liftKaehlerDifferential =
      Φ ∘ₗ (traceDerivation (B := B) D₀).liftKaehlerDifferential := by
    refine Derivation.liftKaehlerDifferential_unique _ _ ?_
    ext a : 1
    refine LinearMap.ext fun c ↦ ?_
    change (traceDerivation (B := B) D).liftKaehlerDifferential (KaehlerDifferential.D k B a) c =
      L ((traceDerivation (B := B) D₀).liftKaehlerDifferential (KaehlerDifferential.D k B a) c)
    rw [Derivation.liftKaehlerDifferential_comp_D, Derivation.liftKaehlerDifferential_comp_D]
    change traceDeriv D a c = L (traceDeriv D₀ a c)
    conv_lhs => rw [hDL]
    exact traceDeriv_compDer D₀ L.toLinearMap a c
  rw [heq, LinearMap.coe_comp]
  exact hΦ.comp hbij

end KaehlerDifferential
