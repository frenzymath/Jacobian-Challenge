/-!
# Duality for the trace of differentials over an arbitrary field

Let `k` be a field, `R = k[t]_g` a localization of the polynomial ring at a nonzero `g`, with the
derivation `D = d/dt`, and `B` a smooth `k`-algebra, finite free over `R`, whose differentials
`Ω_{B/k}` are locally generated by one element (a smooth curve over `k`), and which is generically
unramified over `R`. Then the trace derivation induces an isomorphism `Ω_{B/k} ≅ Hom_R(B, R)`
(`KaehlerDifferential.bijective_liftKaehlerDifferential_traceDerivation_of_smooth`).

Unlike `KaehlerDifferential.bijective_liftKaehlerDifferential_traceDerivation`, no separability
of the residue field extensions of `B/R` is assumed, and `B` need not be a domain: this is the
local form of Grothendieck duality `f^! Ω_{ℙ¹} ≅ Ω_X` for a generically étale finite flat morphism
`f : X → ℙ¹_k` of smooth curves over an arbitrary field.

## Proof

1. *Perfect fields*
   (`KaehlerDifferential.bijective_liftKaehlerDifferential_traceDerivation_of_perfectField`).
   If `k` is perfect and `R` is a principal ideal domain, `B` is reduced and its localizations at
   maximal ideals are regular, hence domains (`Algebra.Smooth.isRegularLocalRing_localization`).
   So the minimal primes of `B` are pairwise coprime and each is generated by `1 - e` for an
   idempotent `e`. Each factor `B ⧸ (1 - e)` is a smooth domain, hence a Dedekind domain, free over
   `R`, with residue fields separable over `k` (as `k` is perfect) and fraction field separable over
   that of `R` (as `Ω_{B/R}` is killed by a nonzerodivisor), so
   `KaehlerDifferential.bijective_liftKaehlerDifferential_traceDerivation` applies to it. Duality
   for `B` follows by
   `KaehlerDifferential.bijective_liftKaehlerDifferential_traceDerivation_of_isIdempotentElem`.
2. *Base change.* For an algebraic closure `k'` of `k`, `k' ⊗[k] R = k'[X]_g` is a principal ideal
   domain, and the hypotheses pass to `k' ⊗[k] B` over `k' ⊗[k] R`. Duality for `B` descends from
   `k' ⊗[k] B` by
   `KaehlerDifferential.bijective_liftKaehlerDifferential_traceDerivation_of_baseChange`.
-/


open Polynomial Algebra

namespace KaehlerDifferential

attribute [local instance] precompModule precompModule_isScalarTower

section Factors

/-- In a reduced ring, an element lying in every minimal prime is zero. -/
theorem _root_.Ideal.eq_zero_of_forall_mem_minimalPrimes {A : Type*} [CommRing A] [IsReduced A]
    (x : A) (hx : ∀ P ∈ minimalPrimes A, x ∈ P) : x = 0 := by
  have : x ∈ sInf (minimalPrimes A) := Submodule.mem_sInf.2 fun P hP ↦ hx P hP
  rw [minimalPrimes, Ideal.sInf_minimalPrimes] at this
  obtain ⟨n, hn⟩ := this
  exact IsReduced.eq_zero x ⟨n, by simpa using hn⟩

/-- Over a ring whose localizations at maximal ideals are domains, distinct minimal primes are
coprime: a maximal ideal containing both would contain two minimal primes of a local domain. -/
theorem _root_.Ideal.isCoprime_of_mem_minimalPrimes {A : Type*} [CommRing A]
    (h : ∀ (m : Ideal A) [m.IsMaximal], IsDomain (Localization.AtPrime m)) {P Q : Ideal A}
    (hP : P ∈ minimalPrimes A) (hQ : Q ∈ minimalPrimes A) (hPQ : P ≠ Q) : IsCoprime P Q := by
  rw [Ideal.isCoprime_iff_sup_eq]
  by_contra hne
  obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ hne
  have := h m
  have hq := RingHom.ker_isPrime (algebraMap A (Localization.AtPrime m))
  have key (p : Ideal A) (hp : p ∈ minimalPrimes A) (hpm : p ≤ m) :
      p = RingHom.ker (algebraMap A (Localization.AtPrime m)) := by
    have hqp : RingHom.ker (algebraMap A (Localization.AtPrime m)) ≤ p := by
      intro a ha
      obtain ⟨⟨s, hs⟩, hsa⟩ := (IsLocalization.map_eq_zero_iff m.primeCompl _ a).1 ha
      have : s * a ∈ p := by rw [hsa]; exact p.zero_mem
      exact (hp.1.1.mem_or_mem this).resolve_left fun hsp ↦ hs (hpm hsp)
    exact le_antisymm (hp.2 ⟨hq, bot_le⟩ hqp) hqp
  exact hPQ ((key P hP (le_sup_left.trans hle)).trans (key Q hQ (le_sup_right.trans hle)).symm)

/-- In a reduced ring with finitely many, pairwise coprime minimal primes, every minimal prime is
generated by `1 - e` for an idempotent `e` (Chinese remainder theorem). -/
theorem _root_.Ideal.exists_isIdempotentElem_span_eq {A : Type*} [CommRing A] [IsReduced A]
    (hfin : (minimalPrimes A).Finite)
    (hcop : ∀ P ∈ minimalPrimes A, ∀ Q ∈ minimalPrimes A, P ≠ Q → IsCoprime P Q)
    {P₀ : Ideal A} (hP₀ : P₀ ∈ minimalPrimes A) :
    ∃ e : A, IsIdempotentElem e ∧ Ideal.span {1 - e} = P₀ := by
  classical
  have hzero := Ideal.eq_zero_of_forall_mem_minimalPrimes (A := A)
  obtain ⟨a, ha, b, hb, hab⟩ := Ideal.isCoprime_iff_exists.1
    (Ideal.isCoprime_biInf (s := hfin.toFinset.erase P₀) (J := _root_.id) fun P hP ↦ hcop _ hP₀ P
      (hfin.mem_toFinset.1 (Finset.mem_of_mem_erase hP)) (Finset.ne_of_mem_erase hP).symm)
  have hbP (P : Ideal A) (hP : P ∈ minimalPrimes A) (hne : P ≠ P₀) : b ∈ P := by
    simp only [Submodule.mem_iInf, _root_.id] at hb
    exact hb P (Finset.mem_erase.2 ⟨hne, hfin.mem_toFinset.2 hP⟩)
  have hmem (x : A) (hx : x ∈ P₀) : x * b = 0 := hzero _ fun P hP ↦ by
    by_cases h : P = P₀
    · exact h ▸ Ideal.mul_mem_right _ _ hx
    · exact Ideal.mul_mem_left _ _ (hbP P hP h)
  refine ⟨b, ?_, le_antisymm ?_ fun x hx ↦ ?_⟩
  · have := hmem a ha
    change b * b = b
    linear_combination (-1 : A) * this + b * hab
  · rw [Ideal.span_le, Set.singleton_subset_iff,
      show 1 - b = a by linear_combination (-1 : A) * hab]
    exact ha
  · have := hmem x hx
    exact Ideal.mem_span_singleton'.2 ⟨x, by linear_combination -this⟩

variable {R B : Type*} [CommRing R] [IsDomain R] [CommRing B] [Algebra R B] [Module.Free R B]

/-- A finite free algebra over a domain injects into its quotients by minimal primes. -/
theorem _root_.Ideal.injective_algebraMap_quotient_of_mem_minimalPrimes {J : Ideal B}
    (hJ : J ∈ minimalPrimes B) : Function.Injective (algebraMap R (B ⧸ J)) := by
  rw [injective_iff_map_eq_zero]
  intro r hr
  by_contra hr0
  have hreg : algebraMap R B r ∈ nonZeroDivisors B := by
    refine mem_nonZeroDivisors_iff_right.2 fun x hx ↦ ?_
    rw [mul_comm, ← Algebra.smul_def] at hx
    exact (smul_eq_zero.1 hx).resolve_left hr0
  refine Set.disjoint_left.1 (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes hJ) ?_ hreg
  rw [SetLike.mem_coe, ← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.algebraMap_eq,
    ← IsScalarTower.algebraMap_apply]
  exact hr

/-- The quotient of a finite free algebra over a domain by a minimal prime is torsion-free. -/
theorem _root_.Ideal.isTorsionFree_quotient_of_mem_minimalPrimes {J : Ideal B}
    (hJ : J ∈ minimalPrimes B) : Module.IsTorsionFree R (B ⧸ J) := by
  have := hJ.1.1
  refine ⟨fun r hr x y hxy ↦ ?_⟩
  have hr0 : algebraMap R (B ⧸ J) r ≠ 0 :=
    (map_ne_zero_iff _ (Ideal.injective_algebraMap_quotient_of_mem_minimalPrimes hJ)).2 hr.ne_zero
  simp only [Algebra.smul_def] at hxy
  exact mul_left_cancel₀ hr0 hxy

omit [IsDomain R] in
/-- `B ⧸ (e)` is torsion-free over `R` for an idempotent `e` of a torsion-free `R`-algebra `B`. -/
theorem _root_.Ideal.isTorsionFree_quotient_span_idempotent {e : B} (he : IsIdempotentElem e) :
    Module.IsTorsionFree R (B ⧸ Ideal.span {e}) :=
  Function.Injective.moduleIsTorsionFree
    ((idempotentProdEquiv R he).symm.toLinearMap ∘ₗ LinearMap.inr R _ _)
    ((idempotentProdEquiv R he).symm.injective.comp (LinearMap.inr_injective (R := R)))
    fun r x ↦ map_smul _ r x

end Factors

section Perfect

attribute [local instance] FractionRing.liftAlgebra FractionRing.isScalarTower_liftAlgebra
  Ideal.Quotient.field

variable {k R B : Type*} [Field k] [CommRing R] [IsDomain R] [IsPrincipalIdealRing R]
  [Algebra k R] [CommRing B] [Algebra R B] [Algebra k B] [IsScalarTower k R B] [Module.Free R B]
  [Module.Finite R B] [Algebra.Smooth k B]

/-- The quotient of `B` by a minimal prime `(1 - e)` satisfies the hypotheses of
`KaehlerDifferential.bijective_liftKaehlerDifferential_traceDerivation` when `k` is perfect. -/
theorem bijective_liftKaehlerDifferential_traceDerivation_quotient [PerfectField k]
    (D : Derivation k R R) (hR : ¬ IsField R) (t : R) (ht : D t = 1)
    (hsm : ∀ q : Ideal B, q.IsMaximal →
      ∃ ω₀ : Ω[B⁄k], ∃ s ∉ q, ∀ ω : Ω[B⁄k], ∃ b : B, s • ω = b • ω₀)
    (hunr : ∃ s ∈ nonZeroDivisors B, ∀ ω : Ω[B⁄R], s • ω = 0)
    {e : B} (he : IsIdempotentElem e) (hJ : Ideal.span {1 - e} ∈ minimalPrimes B)
    [Module.Free R (B ⧸ Ideal.span {1 - e})] :
    Function.Bijective
      (traceDerivation (B := B ⧸ Ideal.span {1 - e}) D).liftKaehlerDifferential := by
  set J := Ideal.span {1 - e}
  set C := B ⧸ J
  have : J.IsPrime := hJ.1.1
  have : IsLocalization.Away e C := IsLocalization.Away.quotient_of_isIdempotentElem he
  have : Algebra.Smooth B C := Algebra.Smooth.of_isLocalization_Away e
  have : Algebra.Smooth k C := Algebra.Smooth.comp k B C
  have hinj := Ideal.injective_algebraMap_quotient_of_mem_minimalPrimes (R := R) hJ
  have : FaithfulSMul R C := (faithfulSMul_iff_algebraMap_injective R C).2 hinj
  have : Ring.DimensionLEOne C := Ring.DimensionLEOne.of_isIntegral R C
  have : IsRegularRing C := Algebra.Smooth.isRegularRing k C
  have : IsIntegrallyClosed C := IsIntegrallyClosed.of_localization_maximal fun p _ _ ↦ by
    have := Ring.DimensionLEOne.localization (Localization.AtPrime p)
      p.primeCompl_le_nonZeroDivisors
    exact IsRegularLocalRing.isIntegrallyClosed (Localization.AtPrime p)
      (Ring.krullDimLE_iff.mp inferInstance)
  have : IsDedekindDomain C := { }
  -- the fraction field extension is separable
  have : Algebra.IsSeparable (FractionRing R) (FractionRing C) := by
    obtain ⟨s, hs, hsΩ⟩ := hunr
    have hsJ : algebraMap B C s ≠ 0 := by
      rw [ne_eq, Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem]
      exact fun h ↦ Set.disjoint_left.1
        (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes hJ) h hs
    have hΩC (ω : Ω[C⁄R]) : algebraMap B C s • ω = 0 := by
      obtain ⟨ω, rfl⟩ := KaehlerDifferential.map_surjective_of_surjective R R B C
        Ideal.Quotient.mk_surjective ω
      rw [algebraMap_smul, ← LinearMap.map_smul, hsΩ, map_zero]
    have : Subsingleton Ω[FractionRing C⁄R] := by
      have hspan := KaehlerDifferential.span_range_map_derivation_of_isLocalization R C
        (FractionRing C) (nonZeroDivisors C)
      have hgen : Set.range (KaehlerDifferential.map R R C (FractionRing C) ∘
          KaehlerDifferential.D R C) ⊆ {0} := by
        rintro _ ⟨c, rfl⟩
        have hu : IsUnit (algebraMap C (FractionRing C) (algebraMap B C s)) :=
          (map_ne_zero_iff _ (IsFractionRing.injective C (FractionRing C))).2 hsJ |>.isUnit
        rw [Set.mem_singleton_iff, ← hu.smul_left_cancel, smul_zero, algebraMap_smul,
          Function.comp_apply, ← LinearMap.map_smul, hΩC, map_zero]
      have hle : Submodule.span (FractionRing C) (Set.range (KaehlerDifferential.map R R C
          (FractionRing C) ∘ KaehlerDifferential.D R C)) ≤ ⊥ :=
        Submodule.span_le.2 fun x hx ↦ by simpa using hgen hx
      rw [hspan] at hle
      exact subsingleton_of_forall_eq 0 fun ω ↦ by simpa using hle (Submodule.mem_top (x := ω))
    have : Subsingleton Ω[FractionRing C⁄FractionRing R] :=
      (KaehlerDifferential.map_surjective R (FractionRing R) (FractionRing C)).subsingleton
    have : Algebra.FormallyUnramified (FractionRing R) (FractionRing C) := ⟨inferInstance⟩
    have := finiteDimensional_fractionRing R C
    exact (Algebra.FormallyUnramified.iff_isSeparable _ _).1 inferInstance
  -- the residue field extensions are separable
  have hres (q : Ideal C) (hq : q.IsMaximal) : Algebra.IsSeparable (R ⧸ q.under R) (C ⧸ q) := by
    have : Algebra.FiniteType k (C ⧸ q) :=
      .of_surjective (Ideal.Quotient.mkₐ k q) (Ideal.Quotient.mkₐ_surjective k q)
    have := finite_of_finite_type_of_isJacobsonRing k (C ⧸ q)
    exact Algebra.isSeparable_tower_top_of_isSeparable k (R ⧸ q.under R) (C ⧸ q)
  -- `Ω_{C/k}` is locally generated by one element
  have hsm' (q : Ideal C) (hq : q.IsMaximal) :
      ∃ ω₀ : Ω[C⁄k], ∃ s ∉ q, ∀ ω : Ω[C⁄k], ∃ b : C, s • ω = b • ω₀ := by
    obtain ⟨ω₀, s, hs, h⟩ := hsm (q.comap (algebraMap B C))
      (Ideal.comap_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective)
    refine ⟨KaehlerDifferential.map k k B C ω₀, algebraMap B C s, hs, fun ω ↦ ?_⟩
    obtain ⟨ω, rfl⟩ := KaehlerDifferential.map_surjective_of_surjective k k B C
      Ideal.Quotient.mk_surjective ω
    obtain ⟨b, hb⟩ := h ω
    refine ⟨algebraMap B C b, ?_⟩
    rw [algebraMap_smul, algebraMap_smul, ← LinearMap.map_smul, ← LinearMap.map_smul, hb]
  exact bijective_liftKaehlerDifferential_traceDerivation D hR t ht hres hsm'

/-- **Duality for the trace of differentials over a perfect field.** Let `k` be a perfect field,
`R` a principal ideal domain over `k` which is not a field, with a `k`-derivation `D` and
`D t = 1`, and `B` a smooth `k`-algebra, finite free over `R`, such that `Ω_{B/k}` is locally
generated by one element and `Ω_{B/R}` is killed by a nonzerodivisor. Then the trace derivation
induces an isomorphism `Ω_{B/k} ≅ Hom_R(B, R)`. -/
theorem bijective_liftKaehlerDifferential_traceDerivation_of_perfectField [PerfectField k]
    (D : Derivation k R R) (hR : ¬ IsField R) (t : R) (ht : D t = 1)
    (hsm : ∀ q : Ideal B, q.IsMaximal →
      ∃ ω₀ : Ω[B⁄k], ∃ s ∉ q, ∀ ω : Ω[B⁄k], ∃ b : B, s • ω = b • ω₀)
    (hunr : ∃ s ∈ nonZeroDivisors B, ∀ ω : Ω[B⁄R], s • ω = 0) :
    Function.Bijective (traceDerivation (B := B) D).liftKaehlerDifferential := by
  have : IsReduced B := Algebra.Smooth.isReduced_of_field k B
  have : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing k B
  have hdom (m : Ideal B) [m.IsMaximal] : IsDomain (Localization.AtPrime m) := by
    have := Algebra.Smooth.isRegularLocalRing_localization k B m
    infer_instance
  apply bijective_liftKaehlerDifferential_traceDerivation_of_isIdempotentElem
  intro q hq
  obtain ⟨P₀, hP₀, hP₀q⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ q)
  obtain ⟨e, he, hspan⟩ := Ideal.exists_isIdempotentElem_span_eq
    (minimalPrimes.finite_of_isNoetherianRing B)
    (fun P hP Q hQ hPQ ↦ Ideal.isCoprime_of_mem_minimalPrimes hdom hP hQ hPQ) hP₀
  have heq : e ∉ q := fun h ↦ hq.ne_top ((Ideal.eq_top_iff_one _).2 (by
    have : 1 - e ∈ q := hP₀q (hspan ▸ Ideal.mem_span_singleton_self _)
    simpa using q.add_mem this h))
  have hJ : Ideal.span {1 - e} ∈ minimalPrimes B := hspan ▸ hP₀
  have := Ideal.isTorsionFree_quotient_of_mem_minimalPrimes (R := R) hJ
  have := Ideal.isTorsionFree_quotient_span_idempotent (R := R) he
  exact ⟨e, he, heq, inferInstance, inferInstance,
    bijective_liftKaehlerDifferential_traceDerivation_quotient D hR t ht hsm hunr he hJ⟩

end Perfect

section Unramified

/-- A reduced noetherian algebra of finite type over `R` which is formally unramified over `R` at
its minimal primes has `Ω_{B/R}` killed by a nonzerodivisor: the annihilator of `Ω_{B/R}` is not
contained in any minimal prime, hence (prime avoidance) not in their union, which is the set of
zero divisors. -/
theorem _root_.KaehlerDifferential.exists_mem_nonZeroDivisors_smul_eq_zero {R B : Type*}
    [CommRing R] [CommRing B] [Algebra R B] [Algebra.FiniteType R B] [IsReduced B]
    [IsNoetherianRing B]
    (h : ∀ (P : Ideal B) [P.IsPrime], P ∈ minimalPrimes B →
      Algebra.FormallyUnramified R (Localization.AtPrime P)) :
    ∃ s ∈ nonZeroDivisors B, ∀ ω : Ω[B⁄R], s • ω = 0 := by
  classical
  have hfin := minimalPrimes.finite_of_isNoetherianRing B
  have hI (P : Ideal B) (hP : P ∈ minimalPrimes B) :
      ¬ Module.annihilator B Ω[B⁄R] ≤ P := by
    have := hP.1.1
    have := h P hP
    have : Subsingleton (LocalizedModule P.primeCompl Ω[B⁄R]) :=
      (IsLocalizedModule.iso P.primeCompl
        (KaehlerDifferential.map R R B (Localization.AtPrime P))).toEquiv.subsingleton
    have hns : (⟨P, inferInstance⟩ : PrimeSpectrum B) ∉ Module.support B Ω[B⁄R] :=
      Module.notMem_support_iff.2 this
    rwa [Module.mem_support_iff_of_finite] at hns
  have hav : ¬ ((Module.annihilator B Ω[B⁄R] : Set B) ⊆
      ⋃ P ∈ (hfin.toFinset : Set (Ideal B)), ((_root_.id P : Ideal B) : Set B)) := by
    intro hsub
    obtain ⟨P, hP, hle⟩ := (Ideal.subset_union_prime (f := _root_.id) ⊥ ⊥
      fun P hP _ _ ↦ (hfin.mem_toFinset.1 hP).1.1).1 hsub
    exact hI P (hfin.mem_toFinset.1 hP) hle
  obtain ⟨s, hsI, hs⟩ := Set.not_subset.1 hav
  simp only [Set.mem_iUnion, Set.Finite.coe_toFinset, _root_.id, not_exists] at hs
  refine ⟨s, mem_nonZeroDivisors_iff_right.2 fun y hy ↦ ?_,
    fun ω ↦ Module.mem_annihilator.1 hsI ω⟩
  refine Ideal.eq_zero_of_forall_mem_minimalPrimes y fun P hP ↦ ?_
  have := hP.1.1
  exact (this.mem_or_mem (hy ▸ P.zero_mem : y * s ∈ P)).resolve_right (hs P hP)

end Unramified

section LocalizationPolynomial

/-- A localization of a principal ideal ring is a principal ideal ring. -/
theorem _root_.IsLocalization.isPrincipalIdealRing {A S : Type*} [CommRing A] [CommRing S]
    [Algebra A S] (M : Submonoid A) [IsLocalization M S] [IsPrincipalIdealRing A] :
    IsPrincipalIdealRing S where
  principal J := by
    obtain ⟨a, ha⟩ := Submodule.IsPrincipal.principal (Ideal.under A J)
    refine ⟨⟨algebraMap A S a, ?_⟩⟩
    rw [← IsLocalization.map_under M S J]
    change Ideal.map _ (Ideal.under A J) = _
    rw [ha, Ideal.map_span, Set.image_singleton]

/-- The localization `K[X]_f` of a polynomial ring over an infinite field at a nonzero `f` is not a
field: `X - c` is not invertible for `f(c) ≠ 0`. -/
theorem _root_.Polynomial.not_isField_localization_away {K : Type*} [Field K] [Infinite K]
    {f : K[X]} (hf : f ≠ 0) : ¬ IsField (Localization.Away f) := by
  obtain ⟨c, hc⟩ : ∃ c, f.eval c ≠ 0 := by
    by_contra! h
    exact hf (Polynomial.zero_of_eval_zero f h)
  let ev : Localization.Away f →+* K :=
    IsLocalization.Away.lift f (g := Polynomial.evalRingHom c) (isUnit_iff_ne_zero.2 hc)
  intro hfield
  have hne : algebraMap K[X] (Localization.Away f) (X - C c) ≠ 0 :=
    (map_ne_zero_iff _ (IsLocalization.injective _
      (powers_le_nonZeroDivisors_of_noZeroDivisors hf))).2 (X_sub_C_ne_zero c)
  obtain ⟨b, hb⟩ := hfield.mul_inv_cancel hne
  have := congrArg ev hb
  rw [map_mul, map_one] at this
  simp [ev, IsLocalization.Away.lift, IsLocalization.lift_eq] at this

open TensorProduct in
/-- For `R = k[X]_g`, the base change `k' ⊗[k] R` is the localization `k'[X]_g`. -/
noncomputable def _root_.Polynomial.tensorLocalizationAwayEquiv (k k' : Type*) [Field k]
    [Field k'] [Algebra k k'] (R : Type*) [CommRing R] [Algebra k R] [Algebra k[X] R]
    [IsScalarTower k k[X] R] (g : k[X]) [IsLocalization.Away g R] :
    k' ⊗[k] R ≃+* Localization.Away (g.map (algebraMap k k')) :=
  (IsLocalization.Away.tensorProductEquivTMulRight k k' g R).toRingEquiv.trans
    (IsLocalization.ringEquivOfRingEquiv (M := Submonoid.powers ((1 : k') ⊗ₜ[k] g))
      (T := Submonoid.powers (g.map (algebraMap k k'))) _ _
      (polyEquivTensor k k').symm.toRingEquiv (by
        rw [Submonoid.map_powers]
        congr 1
        change (polyEquivTensor k k').symm ((1 : k') ⊗ₜ[k] g) = _
        rw [polyEquivTensor_symm_apply_tmul_eq_smul, one_smul]))

end LocalizationPolynomial

open TensorProduct in
/-- **Duality for the trace of differentials over an arbitrary field.** Let `R = k[t]_g` be a
localization of `k[t]` at a nonzero polynomial `g`, with a `k`-derivation `D` of `R` such that
`D t = 1`, and let `B` be a smooth `k`-algebra, finite free over `R`, such that `Ω_{B/k}` is
locally generated by one element and `B` is unramified over `R` at its minimal primes. Then the
trace derivation induces an isomorphism `Ω_{B/k} ≅ Hom_R(B, R)`,
`c da ↦ (b ↦ Tr(bC · D(A)))`. -/
theorem bijective_liftKaehlerDifferential_traceDerivation_of_smooth {k R B : Type*} [Field k]
    [CommRing R] [Algebra k R] [Algebra k[X] R] [IsScalarTower k k[X] R] (g : k[X]) (hg : g ≠ 0)
    [IsLocalization.Away g R] [CommRing B] [Algebra R B] [Algebra k B] [IsScalarTower k R B]
    [Module.Free R B] [Module.Finite R B] [Algebra.Smooth k B]
    (D : Derivation k R R) (hD : D (algebraMap k[X] R X) = 1)
    (hsm : ∀ q : Ideal B, q.IsMaximal →
      ∃ ω₀ : Ω[B⁄k], ∃ s ∉ q, ∀ ω : Ω[B⁄k], ∃ b : B, s • ω = b • ω₀)
    (hgen : ∀ (p : Ideal B) [p.IsPrime], p ∈ minimalPrimes B →
      Algebra.FormallyUnramified R (Localization.AtPrime p)) :
    Function.Bijective (traceDerivation (B := B) D).liftKaehlerDifferential := by
  classical
  have : IsReduced B := Algebra.Smooth.isReduced_of_field k B
  have : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing k B
  have hunr := KaehlerDifferential.exists_mem_nonZeroDivisors_smul_eq_zero hgen
  -- base change to an algebraic closure `k'` of `k`
  let k' := AlgebraicClosure k
  let := Algebra.TensorProduct.baseChangeAlgebra k k' R B
  have := Algebra.TensorProduct.baseChangeAlgebra_isScalarTower k k' R B
  have := Algebra.TensorProduct.free_baseChange (k := k) (k' := k') (R := R) (B := B)
  have := Algebra.TensorProduct.finite_baseChange (k := k) (k' := k') (R := R) (B := B)
  obtain ⟨l, hl⟩ := LinearMap.exists_leftInverse_of_injective (Algebra.linearMap k k')
    (LinearMap.ker_eq_bot.2 (algebraMap k k').injective)
  refine bijective_liftKaehlerDifferential_traceDerivation_of_baseChange k' D l ?_ ?_
  · simpa using LinearMap.congr_fun hl 1
  -- `k' ⊗[k] R = k'[X]_g` is a principal ideal domain which is not a field
  let e := Polynomial.tensorLocalizationAwayEquiv k k' R g
  have hg' : g.map (algebraMap k k') ≠ 0 :=
    (Polynomial.map_ne_zero_iff (algebraMap k k').injective).2 hg
  have : IsDomain (Localization.Away (g.map (algebraMap k k'))) :=
    IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hg')
  have : IsDomain (k' ⊗[k] R) := e.toMulEquiv.isDomain _
  have : IsPrincipalIdealRing (Localization.Away (g.map (algebraMap k k'))) :=
    IsLocalization.isPrincipalIdealRing (Submonoid.powers (g.map (algebraMap k k')))
  have : IsPrincipalIdealRing (k' ⊗[k] R) := .of_surjective e.symm.toRingHom e.symm.surjective
  have hR : ¬ IsField (k' ⊗[k] R) := fun h ↦
    Polynomial.not_isField_localization_away hg' (MulEquiv.isField h e.symm.toMulEquiv)
  refine bijective_liftKaehlerDifferential_traceDerivation_of_perfectField (D.baseChange k') hR
    (1 ⊗ₜ algebraMap k[X] R X) ?_ (exists_smul_eq_smul_baseChange k' hsm)
    (exists_mem_nonZeroDivisors_smul_eq_zero_baseChange k' hunr)
  rw [Derivation.baseChange_tmul, hD, Algebra.TensorProduct.one_def]

end KaehlerDifferential
